<style>
    .tn-nav-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 16px 16px 12px;
        border-bottom: 1px solid rgba(255,255,255,.08);
        margin-bottom: 8px;
        text-decoration: none;
    }
    .tn-nav-brand-icon {
        width: 32px; height: 32px;
        background: #2563eb;
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .tn-nav-brand-text { font-size: 15px; font-weight: 700; color: #fff; letter-spacing: -.2px; }
    .tn-nav-brand-sub  { font-size: 11px; color: rgba(255,255,255,.40); line-height: 1.2; }

    .tn-nav-section {
        padding: 12px 12px 4px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: rgba(255,255,255,.30);
    }

    .tn-nav-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 16px;
        margin: 1px 8px;
        border-radius: 7px;
        color: rgba(255,255,255,.70);
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 500;
        transition: background .12s, color .12s;
    }
    .tn-nav-link:hover  { background: rgba(255,255,255,.08); color: #fff; text-decoration: none; }
    .tn-nav-link.active { background: rgba(37,99,235,.35); color: #fff; }
    .tn-nav-link i      { width: 16px; text-align: center; font-size: 13px; flex-shrink: 0; }

    .tn-nav-bottom {
        margin-top: auto;
        padding: 12px 8px 16px;
        border-top: 1px solid rgba(255,255,255,.08);
    }

    @@media (max-width: 768px) {
        .tn-nav-links { display: none; }
        .tn-nav-links.open { display: block; }
    }
</style>

<a href="/" class="tn-nav-brand">
    <div class="tn-nav-brand-icon">
        <i class="fa-solid fa-gears" style="color:#fff;font-size:14px;"></i>
    </div>
    <div>
        <div class="tn-nav-brand-text">ТехНорм</div>
        <div class="tn-nav-brand-sub">НСИ производства</div>
    </div>
</a>

<div class="tn-nav-links" id="tn-nav-links" style="display:flex;flex-direction:column;flex:1;">

    <div class="tn-nav-section">Навигация</div>

    <NavLink class="tn-nav-link" href="/" Match="NavLinkMatch.All">
        <i class="fa-solid fa-house"></i>
        Главная
    </NavLink>

    <NavLink class="tn-nav-link" href="/events">
        <i class="fa-solid fa-bolt"></i>
        Журнал событий
    </NavLink>

    <NavLink class="tn-nav-link" href="/import">
        <i class="fa-solid fa-file-arrow-up"></i>
        Загрузка файлов
    </NavLink>

    <NavLink class="tn-nav-link" href="/nsi">
        <i class="fa-solid fa-diagram-project"></i>
        НСИ
    </NavLink>

    <NavLink class="tn-nav-link" href="/journal">
        <i class="fa-solid fa-clock-rotate-left"></i>
        История
    </NavLink>

    <AuthorizeView Roles="admin">
        <Authorized>
            <div class="tn-nav-section" style="margin-top:8px;">Администрирование</div>

            <NavLink class="tn-nav-link" href="/admin/users">
                <i class="fa-solid fa-users"></i>
                Пользователи
            </NavLink>

            <NavLink class="tn-nav-link" href="/admin/refs">
                <i class="fa-solid fa-book"></i>
                Справочники
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <div style="flex:1;"></div>

    <div class="tn-nav-bottom">
        <NavLink class="tn-nav-link" href="/profile">
            <i class="fa-regular fa-circle-user"></i>
            Профиль
        </NavLink>
        <a class="tn-nav-link" href="/logout" @onclick="Logout" @onclick:preventDefault>
            <i class="fa-solid fa-right-from-bracket"></i>
            Выход
        </a>
    </div>

</div>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    private void Logout() => Nav.NavigateTo("/logout", forceLoad: true);
}
