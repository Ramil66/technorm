@inherits LayoutComponentBase

<div id="tn-nav-progress" style="position:fixed;top:0;left:0;height:3px;width:0;opacity:0;background:linear-gradient(90deg,#2563eb,#60a5fa);z-index:10000;pointer-events:none;border-radius:0 2px 2px 0;box-shadow:0 0 10px rgba(37,99,235,.5);"></div>

<div class="page">
    <div class="sidebar" style="display:flex;flex-direction:column;">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <span style="font-size:13px;color:var(--tn-text-muted);">
                <i class="fa-solid fa-building-columns" style="margin-right:6px;opacity:.5;"></i>
                Система нормирования производства
            </span>

            <AuthorizeView>
                <Authorized>
                    <div style="display:flex;align-items:center;gap:10px;margin-left:auto;">

                        <AuthorizeView Roles="admin">
                            <Authorized Context="_">
                                <span class="badge-status badge-new" style="font-size:11px;">
                                    <i class="fa-solid fa-shield-halved" style="font-size:10px;"></i>
                                    Администратор
                                </span>
                            </Authorized>
                            <NotAuthorized Context="_">
                                <span class="badge-status badge-published" style="font-size:11px;">
                                    <i class="fa-solid fa-user-gear" style="font-size:10px;"></i>
                                    Технолог
                                </span>
                            </NotAuthorized>
                        </AuthorizeView>

                        <a href="/profile"
                           style="display:flex;align-items:center;gap:7px;text-decoration:none;color:var(--tn-text);font-size:13px;font-weight:500;padding:5px 10px;border:1px solid var(--tn-border);border-radius:6px;transition:all .15s;"
                           onmouseover="this.style.borderColor='#93c5fd'"
                           onmouseout="this.style.borderColor='var(--tn-border)'">
                            <i class="fa-regular fa-circle-user" style="color:#94a3b8;font-size:15px;"></i>
                            @(context.User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value
                              ?? context.User.Identity?.Name)
                        </a>

                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <i class="fa-solid fa-triangle-exclamation" style="color:#ca8a04;"></i>
    Произошла ошибка в приложении.
    <a href="." class="reload">Перезагрузить страницу</a>
    <span class="dismiss">✕</span>
</div>
