@page "/"
@attribute [Authorize]

<PageTitle>Главная — ТехНорм</PageTitle>

<h1>Добро пожаловать в систему ТехНорм</h1>

<AuthorizeView>
    <Authorized>
        <p class="text-muted">
            Вы вошли как <strong>@context.User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value</strong>.
        </p>
    </Authorized>
</AuthorizeView>
