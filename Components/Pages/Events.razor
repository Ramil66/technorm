@page "/events"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject IEventLogService EventSvc
@inject IProductService ProductSvc
@inject IOperationService OperationSvc
@inject IResourceService ResourceSvc
@inject IAuditLogService AuditSvc
@inject IRouteBuilderService RouteBuildSvc
@inject IOperationMatcherService MatcherSvc
@inject IJSRuntime JS

<PageTitle>Журнал событий — ТехНорм</PageTitle>

@if (errorMessage is not null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" style="font-size:13px;">
        <i class="fa-solid fa-circle-exclamation"></i>@errorMessage
    </div>
}

<div class="page-header">
    <h1><i class="fa-solid fa-bolt" style="color:var(--tn-blue);margin-right:10px;font-size:18px;"></i>Журнал событий</h1>
    <span class="text-muted" style="font-size:13px;">
        @if (isLoading)
        {
            <span class="spinner-border spinner-border-sm me-1" style="width:12px;height:12px;border-width:2px;"></span>
        }
        @totalCount.ToString("N0") записей
    </span>
</div>

<AuthorizeView Roles="technologist">
    <Authorized>
        <!-- Форма добавления -->
        <div class="card mb-4">
            <div class="card-header" style="cursor:pointer;" @onclick="ToggleForm">
                <i class="fa-solid fa-plus" style="color:var(--tn-blue);margin-right:6px;"></i>
                Добавить событие
                <i class="fa-solid @(showForm ? "fa-chevron-up" : "fa-chevron-down")" style="float:right;color:var(--tn-text-muted);"></i>
            </div>
            @if (showForm)
            {
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Изделие</label>
                            <select class="form-select" @bind="form.ProductId">
                                <option value="">— не выбрано —</option>
                                @foreach (var p in products)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">ID дела</label>
                            <input class="form-control" placeholder="case-001" @bind="form.CaseId" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Операция из справочника</label>
                            <select class="form-select" @bind="form.OperationId" @bind:after="FillActivity">
                                <option value="">— не выбрано —</option>
                                @foreach (var op in operations)
                                {
                                    <option value="@op.Id">@op.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Наименование операции</label>
                            <input class="form-control" placeholder="Введите название операции"
                                   value="@form.Activity" @onchange="OnActivityChanged" />
                            @if (isMatchingActivity)
                            {
                                <div class="mt-1" style="font-size:12px;color:#64748b;">
                                    <span class="spinner-border spinner-border-sm me-1" style="width:12px;height:12px;border-width:2px;"></span>Сопоставление...
                                </div>
                            }
                            else if (activityMatchResult is not null)
                            {
                                @if (activityMatchResult.Status == MatchStatus.AutoMatched && activityMatchResult.Operation is not null)
                                {
                                    <div class="mt-1 d-flex align-items-center gap-1" style="font-size:12px;color:#16a34a;">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Сопоставлено: <strong class="ms-1">@activityMatchResult.Operation.Name</strong>
                                        <span class="ms-1" style="color:#86efac;">(@((int)(activityMatchResult.Confidence * 100))%)</span>
                                    </div>
                                }
                                else if (activityMatchResult.Status == MatchStatus.NeedsConfirm && activityMatchResult.Operation is not null)
                                {
                                    <div class="mt-1 d-flex align-items-center gap-2" style="font-size:12px;background:#fef9c3;border-radius:4px;padding:4px 8px;border:1px solid #fde047;">
                                        <i class="fa-solid fa-circle-question" style="color:#ca8a04;"></i>
                                        <span>Возможное соответствие: <strong>@activityMatchResult.Operation.Name</strong>
                                            <span style="color:#78716c;">(@((int)(activityMatchResult.Confidence * 100))%)</span></span>
                                        <button class="btn py-0 px-2 ms-auto" style="font-size:11px;background:#fef08a;border:1px solid #ca8a04;color:#713f12;"
                                                @onclick="ConfirmActivityMatch">
                                            <i class="fa-solid fa-check me-1"></i>Подтвердить
                                        </button>
                                    </div>
                                }
                                else if (activityMatchResult.Status == MatchStatus.Unmatched)
                                {
                                    <div class="mt-1" style="font-size:12px;color:#94a3b8;">
                                        <i class="fa-solid fa-circle-xmark"></i> Операция не найдена в справочнике
                                    </div>
                                }
                            }
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Дата и время</label>
                            <input type="datetime-local" class="form-control" @bind="form.Timestamp" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Смена</label>
                            <select class="form-select" @bind="form.Shift">
                                <option value="1">Смена 1</option>
                                <option value="2">Смена 2</option>
                                <option value="3">Смена 3</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ресурс / Оборудование</label>
                            <select class="form-select" @bind="form.ResourceId">
                                <option value="">— не выбрано —</option>
                                @foreach (var r in resources)
                                {
                                    <option value="@r.Id">@r.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Длительность (мин)</label>
                            <input type="number" class="form-control" min="0" step="0.5" @bind="form.DurationMinutes" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Количество (шт)</label>
                            <input type="number" class="form-control" min="0" @bind="form.Quantity" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Примечания</label>
                            <textarea class="form-control" rows="2" placeholder="Необязательно" @bind="form.Notes"></textarea>
                        </div>
                    </div>
                    @if (formError is not null)
                    {
                        <div class="alert alert-danger mt-3 mb-0 py-2" style="font-size:13px;">@formError</div>
                    }
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary" @onclick="SaveEvent">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Записать
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ResetForm">
                            <i class="fa-solid fa-rotate-left me-1"></i>Сбросить
                        </button>
                    </div>
                </div>
            }
        </div>
    </Authorized>
</AuthorizeView>

<!-- Фильтры -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label mb-1">Изделие</label>
                <select class="form-select form-select-sm" @bind="filterProductId" @bind:after="ApplyFilter">
                    <option value="0">Все изделия</option>
                    @foreach (var p in products)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label mb-1">Источник</label>
                <select class="form-select form-select-sm" @bind="filterSource" @bind:after="ApplyFilter">
                    <option value="">Все источники</option>
                    <option value="manual">Вручную</option>
                    <option value="document">Из документа</option>
                </select>
            </div>
            <div class="col-md-4">
                <input class="form-control form-control-sm" placeholder="Поиск по операции..." @bind="filterSearch" @bind:after="ApplyFilter" />
            </div>
        </div>
    </div>
</div>

<!-- Таблица -->
<div class="card">
    <div class="card-body p-0">
        @if (!isLoading && !pagedItems.Any())
        {
            <div class="empty-state">
                <i class="fa-solid fa-bolt d-block"></i>
                <div>Событий не найдено</div>
            </div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID дела</th>
                            <th>Операция</th>
                            <th>Дата / Смена</th>
                            <th>Ресурс</th>
                            <th>Изделие</th>
                            <th>Длит., мин</th>
                            <th>Кол-во</th>
                            <th>Источник</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && !pagedItems.Any())
                        {
                            @for (int i = 0; i < 10; i++)
                            {
                                <tr>
                                    <td><div class="tn-skel" style="height:13px;width:72px;"></div></td>
                                    <td><div class="tn-skel" style="height:13px;width:130px;"></div></td>
                                    <td><div class="tn-skel" style="height:13px;width:90px;"></div></td>
                                    <td><div class="tn-skel" style="height:13px;width:80px;"></div></td>
                                    <td><div class="tn-skel" style="height:13px;width:110px;"></div></td>
                                    <td><div class="tn-skel" style="height:13px;width:32px;"></div></td>
                                    <td><div class="tn-skel" style="height:13px;width:28px;"></div></td>
                                    <td><div class="tn-skel" style="height:18px;width:64px;border-radius:10px;"></div></td>
                                    <td></td>
                                </tr>
                            }
                        }
                        @foreach (var e in pagedItems)
                        {
                            <tr>
                                <td style="font-family:monospace;font-size:12px;">@e.CaseId</td>
                                <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@e.Activity">@e.Activity</td>
                                <td style="white-space:nowrap;">
                                    @e.Timestamp.ToString("dd.MM.yy HH:mm")
                                    @{ var shift = GetMeta(e, "Shift"); }
                                    @if (shift is not null)
                                    {
                                        <span class="ms-1 badge-status badge-new" style="font-size:11px;">С@shift</span>
                                    }
                                </td>
                                <td>@(e.Resource?.Name ?? "—")</td>
                                <td>@(e.Product?.Name ?? "—")</td>
                                <td>@(e.Duration.HasValue ? Math.Round(e.Duration.Value.TotalMinutes, 1).ToString() : "—")</td>
                                <td>@(GetMeta(e, "Quantity") ?? "—")</td>
                                <td>
                                    <span class="badge-status @(e.Source == "manual" ? "badge-new" : "badge-processed")" style="font-size:11px;">
                                        @(e.Source == "manual" ? "Вручную" : "Документ")
                                    </span>
                                </td>
                                <td style="white-space:nowrap;">
                                    <AuthorizeView Roles="technologist">
                                        <Authorized>
                                            <button class="btn btn-sm btn-outline-secondary py-0 px-2 me-1"
                                                    title="Редактировать" @onclick="() => OpenEditModal(e)">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                    <AuthorizeView Roles="technologist">
                                        <Authorized>
                                            <button class="btn btn-sm btn-outline-danger py-0 px-2"
                                                    title="Удалить" @onclick="() => AskDeleteEvent(e.Id)">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    @if (hasMore || isLoadingMore)
    {
        <div id="tn-scroll-sentinel" style="padding:16px;text-align:center;color:#94a3b8;font-size:13px;">
            @if (isLoadingMore)
            {
                <span class="spinner-border spinner-border-sm me-2" style="width:14px;height:14px;border-width:2px;"></span>
                <span>Загрузка событий...</span>
            }
        </div>
    }
    else if (pagedItems.Count > 0)
    {
        <div style="padding:10px 16px;text-align:center;color:#94a3b8;font-size:12px;">
            Показано все @pagedItems.Count.ToString("N0") записей из @totalCount.ToString("N0")
        </div>
    }
</div>

<!-- ── Модалка редактирования ── -->
@if (showEditModal && editingEvent is not null)
{
    <div class="tn-backdrop" @onclick="CloseEditModal">
        <div class="tn-modal" @onclick:stopPropagation style="max-width:680px;">
            <div class="tn-modal-header">
                <h5><i class="fa-solid fa-pen" style="color:var(--tn-blue);margin-right:8px;"></i>Редактировать событие</h5>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <label class="form-label">Изделие</label>
                    <select class="form-select" value="@editingEvent.ProductId"
                            @onchange="e => editingEvent.ProductId = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : null">
                        <option value="">— не выбрано —</option>
                        @foreach (var p in products)
                        {
                            <option value="@p.Id" selected="@(editingEvent.ProductId == p.Id)">@p.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">ID дела</label>
                    <input class="form-control" value="@editingEvent.CaseId"
                           @onchange="e => editingEvent.CaseId = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Смена</label>
                    <select class="form-select" value="@editShift"
                            @onchange="e => editShift = int.TryParse(e.Value?.ToString(), out var s) ? s : 1">
                        <option value="1">Смена 1</option>
                        <option value="2">Смена 2</option>
                        <option value="3">Смена 3</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Наименование операции</label>
                    <input class="form-control" value="@editingEvent.Activity"
                           @onchange="e => editingEvent.Activity = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Дата и время</label>
                    <input type="datetime-local" class="form-control"
                           value="@editingEvent.Timestamp.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")"
                           @onchange="e => { if (DateTime.TryParse(e.Value?.ToString(), out var dt)) editingEvent.Timestamp = dt.ToUniversalTime(); }" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Ресурс / Оборудование</label>
                    <select class="form-select" value="@editingEvent.ResourceId"
                            @onchange="e => editingEvent.ResourceId = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : null">
                        <option value="">— не выбрано —</option>
                        @foreach (var r in resources)
                        {
                            <option value="@r.Id" selected="@(editingEvent.ResourceId == r.Id)">@r.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Длительность (мин)</label>
                    <input type="number" class="form-control" min="0" step="0.5"
                           value="@(editingEvent.Duration.HasValue ? Math.Round(editingEvent.Duration.Value.TotalMinutes, 1).ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                           @onchange="e => editingEvent.Duration = double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) && d > 0 ? TimeSpan.FromMinutes(d) : null" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Количество (шт)</label>
                    <input type="number" class="form-control" min="1"
                           value="@editQty"
                           @onchange="e => editQty = int.TryParse(e.Value?.ToString(), out var q) && q > 0 ? q : 1" />
                </div>
            </div>
            @if (editError is not null)
            {
                <div class="alert alert-danger mt-3 mb-0 py-2" style="font-size:13px;">@editError</div>
            }
            <div class="tn-modal-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseEditModal">Отмена</button>
                <button class="btn btn-primary" @onclick="SaveEditEvent" disabled="@isSavingEdit">
                    @if (isSavingEdit) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> }
                    <i class="fa-solid fa-floppy-disk me-1"></i>Сохранить
                </button>
            </div>
        </div>
    </div>
}

<!-- ── Подтверждение удаления ── -->
@if (showDeleteConfirm)
{
    <div class="tn-backdrop" @onclick="CancelDelete">
        <div class="tn-modal" @onclick:stopPropagation style="max-width:360px;text-align:center;padding:32px 28px;">
            <div style="font-size:44px;margin-bottom:16px;color:#dc2626;">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div style="font-size:16px;font-weight:600;margin-bottom:8px;">Удалить событие?</div>
            <div style="font-size:13px;color:var(--tn-text-muted);margin-bottom:24px;">
                Это действие нельзя отменить.
            </div>
            <div class="d-flex gap-2 justify-content-center">
                <button class="btn btn-outline-secondary" @onclick="CancelDelete">Отмена</button>
                <button class="btn btn-danger" @onclick="ConfirmDelete">
                    <i class="fa-solid fa-trash-can me-1"></i>Удалить
                </button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private List<EventLog>  pagedItems     = [];
    private int             totalCount     = 0;
    private int             currentPage    = 1;
    private const int       pageSize       = 200;
    private bool            isLoading      = false;
    private bool            isLoadingMore  = false;
    private bool            hasMore        = false;
    private string?         errorMessage;
    private int             _lastRenderedCount = -1;
    private DotNetObjectReference<Events>? _dotnetRef;

    private List<Product>   products       = [];
    private List<Operation> operations     = [];
    private List<Resource>  resources      = [];

    private bool   showForm    = false;
    private string? formError  = null;
    private int    filterProductId = 0;
    private string filterSource    = "";
    private string filterSearch    = "";

    private EventForm     form                = new();
    private int           currentUserId;
    private MatchResult?  activityMatchResult;
    private bool          isMatchingActivity  = false;

    private bool      showEditModal = false;
    private EventLog? editingEvent;
    private string?   editError;
    private bool      isSavingEdit;
    private int       editShift = 1;
    private int       editQty   = 1;

    private bool showDeleteConfirm = false;
    private long pendingDeleteId   = 0;

    private class EventForm
    {
        public int?    ProductId       { get; set; }
        public string  CaseId          { get; set; } = "";
        public int?    OperationId     { get; set; }
        public string  Activity        { get; set; } = "";
        public DateTime Timestamp      { get; set; } = DateTime.Now;
        public int     Shift           { get; set; } = 1;
        public int?    ResourceId      { get; set; }
        public double? DurationMinutes { get; set; }
        public int?    Quantity        { get; set; }
        public string? Notes           { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthStateTask;
            currentUserId = int.Parse(state.User.FindFirst("UserId")?.Value ?? "0");

            var t2 = ProductSvc.GetAllAsync();
            var t3 = OperationSvc.GetAllAsync();
            var t4 = ResourceSvc.GetAllAsync();
            await Task.WhenAll(t2, t3, t4);

            products   = t2.Result;
            operations = t3.Result;
            resources  = t4.Result;
            await LoadPageAsync(1);
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки данных: {ex.Message}";
            isLoading = false;
        }
    }

    private async Task LoadPageAsync(int page)
    {
        isLoading   = true;
        currentPage = page;
        StateHasChanged();
        try
        {
            var result = await EventSvc.GetPagedAsync(
                page, pageSize,
                filterProductId > 0 ? filterProductId : null,
                string.IsNullOrEmpty(filterSource) ? null : filterSource,
                string.IsNullOrEmpty(filterSearch) ? null : filterSearch);
            pagedItems = result.Items;
            totalCount = result.Total;
            hasMore    = result.Items.Count == pageSize && pagedItems.Count < totalCount;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilter()
    {
        await LoadPageAsync(1);
    }

    [JSInvokable]
    public async Task OnScrolledToBottom()
    {
        if (isLoadingMore || !hasMore) return;
        isLoadingMore = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var nextPage = currentPage + 1;
            var result   = await EventSvc.GetPagedAsync(
                nextPage, pageSize,
                filterProductId > 0 ? filterProductId : null,
                string.IsNullOrEmpty(filterSource) ? null : filterSource,
                string.IsNullOrEmpty(filterSearch) ? null : filterSearch);
            if (result.Items.Count > 0)
            {
                pagedItems.AddRange(result.Items);
                currentPage = nextPage;
            }
            hasMore = result.Items.Count == pageSize && pagedItems.Count < totalCount;
        }
        finally
        {
            isLoadingMore = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotnetRef = DotNetObjectReference.Create(this);
        }
        if (_dotnetRef is not null && hasMore && pagedItems.Count != _lastRenderedCount)
        {
            _lastRenderedCount = pagedItems.Count;
            await JS.InvokeVoidAsync("tnInterop.setupInfiniteScroll", _dotnetRef, "tn-scroll-sentinel");
        }
    }

    public void Dispose()
    {
        JS.InvokeVoidAsync("tnInterop.disposeInfiniteScroll");
        _dotnetRef?.Dispose();
    }

    private void FillActivity()
    {
        if (form.OperationId.HasValue)
        {
            var op = operations.FirstOrDefault(o => o.Id == form.OperationId.Value);
            if (op is not null && string.IsNullOrEmpty(form.Activity))
                form.Activity = op.Name;
        }
    }

    private async Task OnActivityChanged(ChangeEventArgs e)
    {
        form.Activity       = e.Value?.ToString() ?? string.Empty;
        activityMatchResult = null;
        if (string.IsNullOrWhiteSpace(form.Activity)) return;

        isMatchingActivity = true;
        StateHasChanged();
        try
        {
            activityMatchResult = await MatcherSvc.MatchAsync(form.Activity);
            if (activityMatchResult.Status == MatchStatus.AutoMatched &&
                activityMatchResult.Operation is not null && !form.OperationId.HasValue)
            {
                form.OperationId = activityMatchResult.Operation.Id;
            }
        }
        finally
        {
            isMatchingActivity = false;
        }
    }

    private async Task ConfirmActivityMatch()
    {
        if (activityMatchResult?.Operation is null) return;
        form.OperationId = activityMatchResult.Operation.Id;
        await MatcherSvc.ConfirmMappingAsync(form.Activity, activityMatchResult.Operation.Id,
            activityMatchResult.Confidence, currentUserId);
        activityMatchResult = new MatchResult
        {
            Status          = MatchStatus.AutoMatched,
            Operation       = activityMatchResult.Operation,
            Confidence      = activityMatchResult.Confidence,
            NormalizedInput = activityMatchResult.NormalizedInput,
            WasCached       = false,
        };
    }

    private async Task SaveEvent()
    {
        formError = null;
        if (string.IsNullOrWhiteSpace(form.Activity))  { formError = "Введите наименование операции."; return; }
        if (string.IsNullOrWhiteSpace(form.CaseId))    { formError = "Введите ID дела."; return; }

        var meta = new { Shift = form.Shift, Quantity = form.Quantity, Notes = form.Notes, OperationId = form.OperationId };
        var metaJson = JsonDocument.Parse(JsonSerializer.Serialize(meta));

        var ev = new EventLog
        {
            CaseId     = form.CaseId.Trim(),
            Activity   = form.Activity.Trim(),
            Timestamp  = form.Timestamp.ToUniversalTime(),
            ProductId  = form.ProductId,
            ResourceId = form.ResourceId,
            Duration   = form.DurationMinutes.HasValue ? TimeSpan.FromMinutes(form.DurationMinutes.Value) : null,
            Source     = "manual",
            CreatedBy  = currentUserId,
            Metadata   = metaJson,
        };

        var created = await EventSvc.CreateAsync(ev);

        if (activityMatchResult is { Status: MatchStatus.AutoMatched, Operation: not null, WasCached: false })
            await MatcherSvc.ConfirmMappingAsync(form.Activity.Trim(), activityMatchResult.Operation.Id,
                activityMatchResult.Confidence, currentUserId);
        await AuditSvc.LogAsync(currentUserId, "Событие добавлено вручную", "EventLog", (int?)created.Id,
            null, new { created.CaseId, created.Activity, ProductId = created.ProductId });
        if (created.ProductId.HasValue)
            await RouteBuildSvc.AutoUpdateIfEnabledAsync(created.ProductId.Value, currentUserId);
        await LoadPageAsync(1);
        ResetForm();
        showForm = false;
    }

    private void OpenEditModal(EventLog e)
    {
        editingEvent = new EventLog
        {
            Id         = e.Id,
            CaseId     = e.CaseId,
            Activity   = e.Activity,
            Timestamp  = e.Timestamp,
            ProductId  = e.ProductId,
            ResourceId = e.ResourceId,
            Duration   = e.Duration,
            Source     = e.Source,
            Metadata   = e.Metadata,
            Product    = e.Product,
            Resource   = e.Resource,
        };
        editShift    = int.TryParse(GetMeta(e, "Shift"),    out var s) ? s : 1;
        editQty      = int.TryParse(GetMeta(e, "Quantity"), out var q) ? q : 1;
        editError    = null;
        isSavingEdit = false;
        showEditModal = true;
    }

    private void CloseEditModal() { showEditModal = false; editingEvent = null; }

    private async Task SaveEditEvent()
    {
        if (editingEvent is null) return;
        editError = null;
        if (string.IsNullOrWhiteSpace(editingEvent.Activity)) { editError = "Введите наименование операции."; return; }
        if (string.IsNullOrWhiteSpace(editingEvent.CaseId))   { editError = "Введите ID дела."; return; }

        isSavingEdit = true;
        try
        {
            var meta = new { Shift = editShift, Quantity = editQty, OperationId = (int?)null };
            editingEvent.Metadata = JsonDocument.Parse(JsonSerializer.Serialize(meta));
            await EventSvc.UpdateAsync(editingEvent);
            await AuditSvc.LogAsync(currentUserId, "Событие изменено", "EventLog", (int?)editingEvent.Id,
                null, new { editingEvent.CaseId, editingEvent.Activity, ProductId = editingEvent.ProductId });

            var local = pagedItems.FirstOrDefault(e => e.Id == editingEvent.Id);
            if (local is not null)
            {
                local.CaseId     = editingEvent.CaseId;
                local.Activity   = editingEvent.Activity;
                local.Timestamp  = editingEvent.Timestamp;
                local.ProductId  = editingEvent.ProductId;
                local.ResourceId = editingEvent.ResourceId;
                local.Duration   = editingEvent.Duration;
                local.Metadata   = editingEvent.Metadata;
                local.Product    = products.FirstOrDefault(p => p.Id == editingEvent.ProductId);
                local.Resource   = resources.FirstOrDefault(r => r.Id == editingEvent.ResourceId);
            }
            CloseEditModal();
        }
        finally { isSavingEdit = false; }
    }

    private void AskDeleteEvent(long id)
    {
        pendingDeleteId  = id;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        pendingDeleteId   = 0;
    }

    private async Task ConfirmDelete()
    {
        showDeleteConfirm = false;
        var deleted = pagedItems.FirstOrDefault(e => e.Id == pendingDeleteId);
        await EventSvc.DeleteAsync(pendingDeleteId);
        await AuditSvc.LogAsync(currentUserId, "Событие удалено", "EventLog", (int?)pendingDeleteId,
            new { CaseId = deleted?.CaseId, Activity = deleted?.Activity }, null);
        pendingDeleteId = 0;
        await LoadPageAsync(currentPage);
    }

    private void ResetForm()
    {
        form                = new EventForm();
        activityMatchResult = null;
    }
    private void ToggleForm() => showForm = !showForm;

    private static string? GetMeta(EventLog e, string key)
    {
        if (e.Metadata is null) return null;
        if (e.Metadata.RootElement.TryGetProperty(key, out var val))
            return val.ToString();
        return null;
    }
}
