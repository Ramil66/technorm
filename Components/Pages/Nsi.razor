@page "/nsi"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ITechRouteService RouteSvc
@inject IRouteStepService StepSvc
@inject IProductService ProductSvc
@inject ITimeNormService TimeNormSvc
@inject IMaterialNormService MatNormSvc
@inject IResourceService ResourceSvc
@inject IMaterialService MatSvc
@inject IOperationService OpSvc
@inject IRouteBuilderService RouteBuildSvc

<PageTitle>НСИ — ТехНорм</PageTitle>

<div class="page-header">
    <h1><i class="fa-solid fa-diagram-project" style="color:var(--tn-blue);margin-right:10px;font-size:18px;"></i>НСИ</h1>
</div>

<!-- Вкладки -->
<div class="tn-tabs">
    @foreach (var (label, icon, idx) in Tabs)
    {
        <button class="tn-tab @(activeTab == idx ? "active" : "")" @onclick="() => SetTab(idx)">
            <i class="@icon me-1"></i>@label
        </button>
    }
</div>

@if (activeTab == 0)
{
    <div class="mk-canvas">
        <!-- ── Горизонтальная панель управления ── -->
        <div class="mk-topbar">
            <div class="mk-topbar-main">
                <div class="mk-topbar-title">
                    <i class="fa-solid fa-route" style="color:var(--tn-blue);"></i>
                    Маршрутные карты
                </div>

                <div class="mk-topbar-select">
                    <span style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--tn-text-muted);white-space:nowrap;">Изделие</span>
                    <select class="form-select form-select-sm" style="min-width:220px;" @bind="routeProductId" @bind:after="LoadProductRoutes">
                        <option value="0">— выберите изделие —</option>
                        @foreach (var p in allProducts)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>

                @if (routeProductId > 0)
                {
                    @if (productRoutes.Any())
                    {
                        <div class="mk-topbar-stat">
                            @{ var pubCnt = productRoutes.Count(r => r.Status == "published"); }
                            <span><strong>@productRoutes.Count</strong> маршрут(ов)</span>
                            @if (pubCnt > 0)
                            {
                                <span class="badge-status badge-published" style="font-size:10px;">@pubCnt осн.</span>
                            }
                        </div>
                    }

                    <div class="d-flex gap-2 align-items-center">
                        <AuthorizeView Roles="technologist">
                            <Authorized>
                                <button class="btn btn-primary btn-sm" @onclick="AutoBuildRoute" disabled="@isMining">
                                    @if (isMining)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-wand-magic-sparkles me-1"></i>
                                    }
                                    Построить из событий
                                </button>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="technologist">
                            <Authorized>
                                <button class="btn btn-outline-primary btn-sm" @onclick="ShowCreateRouteModalFromTab0">
                                    <i class="fa-solid fa-plus me-1"></i>Создать вручную
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                }
            </div>

            @if (minerError is not null)
            {
                <div class="alert alert-danger py-2 mb-0 mt-2" style="font-size:12px;">
                    <i class="fa-solid fa-circle-exclamation me-1"></i>@minerError
                </div>
            }
        </div>

        <!-- ── Область маршрутов ── -->
        <div class="mk-routes-area">
            @if (routeProductId == 0)
            {
                <div class="empty-state" style="border:none;padding-top:80px;">
                    <i class="fa-solid fa-diagram-project d-block" style="opacity:.2;"></i>
                    <div>Выберите изделие для просмотра маршрутных карт</div>
                </div>
            }
            else if (!productRoutes.Any())
            {
                <div class="empty-state" style="border:none;padding-top:80px;">
                    <i class="fa-solid fa-route d-block" style="opacity:.2;"></i>
                    <div>Маршрутных карт нет</div>
                    <div style="font-size:12px;color:var(--tn-text-muted);margin-top:8px;">
                        Загрузите события и нажмите «Построить из событий»
                    </div>
                </div>
            }
            else
            {
                @foreach (var (route, routeIdx) in productRoutes
                    .OrderByDescending(r => r.Status == "published")
                    .ThenByDescending(r => r.Version)
                    .Select((r, i) => (r, i + 1)))
                {
                    bool isExpanded = expandedRouteId == route.Id;
                    bool isMain     = route.Status == "published";
                    routeMetricsCache.TryGetValue(route.Id, out var metrics);

                    <div class="mk-route-block @(isMain ? "mk-route-block-main" : "")">
                        <!-- Заголовок маршрута -->
                        <div class="mk-route-header" @onclick="() => ToggleRoute(route)">
                            <div class="route-radio @(isMain ? "active" : "")" style="flex-shrink:0;"></div>
                            <span class="mk-route-num" title="@route.Name">@TruncText(route.Name, 32)</span>
                            <span style="font-size:11px;color:var(--tn-text-muted);white-space:nowrap;">v@route.Version</span>

                            @if (isMain)
                            {
                                <span class="mk-badge mk-badge-main"><i class="fa-solid fa-star me-1" style="font-size:9px;"></i>Основной</span>
                            }
                            else
                            {
                                <span class="mk-badge mk-badge-alt">@StatusLabel(route.Status)</span>
                            }

                            @if (metrics is not null)
                            {
                                @if (metrics.TotalAvgMin > 0)
                                {
                                    <span class="mk-metric"><i class="fa-regular fa-clock"></i>@metrics.TotalAvgMin мин.</span>
                                }
                                <span class="mk-metric"><i class="fa-solid fa-list-ol"></i>ОП — @metrics.StepCount</span>
                                @if (metrics.ResourceCount > 0)
                                {
                                    <span class="mk-metric"><i class="fa-solid fa-screwdriver-wrench"></i>@metrics.ResourceCount рес.</span>
                                }
                                @if (metrics.Confidence > 0)
                                {
                                    <span class="mk-metric"><i class="fa-solid fa-percent"></i>ЧИ @metrics.Confidence%</span>
                                }
                            }
                            else
                            {
                                <span style="font-size:12px;color:var(--tn-text-muted);">
                                    v@route.Version · @route.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                </span>
                            }

                            <div class="ms-auto d-flex gap-1 align-items-center" @onclick:stopPropagation>
                                @if (!isMain)
                                {
                                    <AuthorizeView Roles="technologist">
                                        <Authorized>
                                            <button class="btn btn-sm btn-outline-primary py-0 px-2"
                                                    title="Сделать основным" @onclick="() => SetDefaultRoute(route)">
                                                <i class="fa-solid fa-star"></i>
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                }
                                <AuthorizeView Roles="technologist">
                                    <Authorized>
                                        <button class="btn btn-sm btn-outline-primary py-0 px-2"
                                                title="Добавить шаг" @onclick="() => PrepareAddStep(route)">
                                            <i class="fa-solid fa-plus"></i>
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                                <AuthorizeView Roles="technologist">
                                    <Authorized>
                                        <button class="btn btn-sm btn-outline-danger py-0 px-2"
                                                title="Удалить маршрут" @onclick="() => DeleteRoute(route)">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                            <i class="fa-solid @(isExpanded ? "fa-chevron-up" : "fa-chevron-down")"
                               style="color:var(--tn-text-muted);flex-shrink:0;"></i>
                        </div>

                        <!-- Развёрнутое содержимое: горизонтальная карта шагов -->
                        @if (isExpanded)
                        {
                            @if (isLoadingSteps)
                            {
                                <div class="d-flex align-items-center gap-2 p-4">
                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                    <span style="font-size:13px;">Загрузка шагов...</span>
                                </div>
                            }
                            else if (!expandedRouteSteps.Any())
                            {
                                <div class="empty-state py-4" style="border:none;">
                                    <i class="fa-solid fa-circle-nodes d-block" style="font-size:28px;"></i>
                                    <div>Маршрут не содержит шагов</div>
                                </div>
                            }
                            else
                            {
                                <!-- Сводная строка -->
                                @if (metrics is not null)
                                {
                                    <div class="mk-steps-summary">
                                        @if (metrics.TotalAvgMin > 0)
                                        {
                                            <span class="mk-summary-chip">
                                                <i class="fa-regular fa-clock" style="color:var(--tn-blue);"></i>
                                                Итого: <strong>@metrics.TotalAvgMin мин.</strong>
                                            </span>
                                        }
                                        @foreach (var (resName, pct) in metrics.ResourceBreakdown.Take(4))
                                        {
                                            <span class="mk-summary-chip">
                                                <i class="fa-solid fa-screwdriver-wrench" style="color:#94a3b8;font-size:11px;"></i>
                                                @resName: <strong>@pct%</strong>
                                            </span>
                                        }
                                        @if (metrics.Confidence > 0)
                                        {
                                            <span class="mk-summary-chip ms-auto">
                                                <i class="fa-solid fa-percent" style="color:#94a3b8;font-size:11px;"></i>
                                                ЧИ (ср.): <strong>@metrics.Confidence%</strong>
                                            </span>
                                        }
                                    </div>
                                }

                                <!-- Горизонтальный поток шагов (с поддержкой параллельных операций) -->
                                <div class="mk-steps-flow">
                                    @foreach (var (stepGroup, gi) in expandedRouteSteps
                                        .GroupBy(s => s.SequenceNum)
                                        .OrderBy(g => g.Key)
                                        .Select((g, i) => (g.ToList(), i)))
                                    {
                                        @if (gi > 0)
                                        {
                                            <div class="mk-step-arrow">
                                                <i class="fa-solid fa-arrow-right"></i>
                                            </div>
                                        }

                                        @if (stepGroup.Count > 1)
                                        {
                                            <div class="mk-parallel-group">
                                                @foreach (var step in stepGroup)
                                                {
                                                    bool sel     = selectedStep?.Id == step.Id;
                                                    var  sName   = step.Operation?.Name ?? step.Description ?? "—";
                                                    var  stepTot = step.TimeNorms.Sum(tn => tn.NormValue);

                                                    <div class="mk-step-card @(sel ? "selected" : "")"
                                                         @onclick="() => SelectStep(step)">
                                                        <div class="mk-step-num">Операция @step.SequenceNum</div>
                                                        <div class="mk-step-name" title="@sName">@TruncText(sName, 24)</div>
                                                        @if (step.Operation?.Code is not null)
                                                        {
                                                            <div class="mk-step-code">@step.Operation.Code</div>
                                                        }
                                                        @if (step.TimeNorms.Any())
                                                        {
                                                            <div class="mk-step-divider"></div>
                                                            @foreach (var tn in step.TimeNorms.OrderByDescending(t => t.NormValue))
                                                            {
                                                                var resPct = stepTot > 0 ? (int)Math.Round(tn.NormValue / stepTot * 100) : 0;
                                                                <div class="mk-step-resource">
                                                                    <i class="fa-solid fa-gear" style="flex-shrink:0;font-size:10px;"></i>
                                                                    <span class="mk-res-name">@(tn.Resource?.Name ?? "Общая")</span>
                                                                    @if (step.TimeNorms.Count > 1) { <span class="mk-res-pct">@resPct%</span> }
                                                                </div>
                                                                <div class="mk-step-time">
                                                                    <i class="fa-regular fa-clock" style="flex-shrink:0;font-size:10px;"></i>
                                                                    @tn.NormValue мин / 1 ед.
                                                                </div>
                                                            }
                                                        }
                                                        else { <div class="mk-step-no-norm">Нормы не заданы</div> }
                                                        @if (sel)
                                                        {
                                                            <div @onclick:stopPropagation style="margin-top:8px;display:flex;flex-direction:column;gap:4px;">
                                                                <AuthorizeView Roles="technologist">
                                                                    <Authorized>
                                                                        <button class="btn btn-sm btn-outline-primary py-0 px-2 w-100" @onclick="() => PrepareEditStep(step)">
                                                                            <i class="fa-solid fa-pen me-1"></i>Редактировать
                                                                        </button>
                                                                        <button class="btn btn-sm btn-outline-danger py-0 px-2 w-100" @onclick="DeleteSelectedStep">
                                                                            <i class="fa-solid fa-trash-can me-1"></i>Удалить
                                                                        </button>
                                                                    </Authorized>
                                                                </AuthorizeView>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            var step     = stepGroup[0];
                                            bool sel     = selectedStep?.Id == step.Id;
                                            var  sName   = step.Operation?.Name ?? step.Description ?? "—";
                                            var  stepTot = step.TimeNorms.Sum(tn => tn.NormValue);

                                            <div class="mk-step-card @(sel ? "selected" : "")"
                                                 @onclick="() => SelectStep(step)">
                                                <div class="mk-step-num">Операция @step.SequenceNum</div>
                                                <div class="mk-step-name" title="@sName">@TruncText(sName, 24)</div>

                                                @if (step.Operation?.Code is not null)
                                                {
                                                    <div class="mk-step-code">@step.Operation.Code</div>
                                                }

                                                @if (step.TimeNorms.Any())
                                                {
                                                    <div class="mk-step-divider"></div>
                                                    @foreach (var tn in step.TimeNorms.OrderByDescending(t => t.NormValue))
                                                    {
                                                        var resPct = stepTot > 0
                                                            ? (int)Math.Round(tn.NormValue / stepTot * 100)
                                                            : 0;
                                                        <div class="mk-step-resource">
                                                            <i class="fa-solid fa-gear" style="flex-shrink:0;font-size:10px;"></i>
                                                            <span class="mk-res-name">@(tn.Resource?.Name ?? "Общая")</span>
                                                            @if (step.TimeNorms.Count > 1)
                                                            {
                                                                <span class="mk-res-pct">@resPct%</span>
                                                            }
                                                        </div>
                                                        <div class="mk-step-time">
                                                            <i class="fa-regular fa-clock" style="flex-shrink:0;font-size:10px;"></i>
                                                            @tn.NormValue мин / 1 ед.
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="mk-step-no-norm">Нормы не заданы</div>
                                                }

                                                @if (sel)
                                                {
                                                    <div @onclick:stopPropagation style="margin-top:8px;display:flex;flex-direction:column;gap:4px;">
                                                        <AuthorizeView Roles="technologist">
                                                            <Authorized>
                                                                <button class="btn btn-sm btn-outline-primary py-0 px-2 w-100"
                                                                        @onclick="() => PrepareEditStep(step)">
                                                                    <i class="fa-solid fa-pen me-1"></i>Редактировать
                                                                </button>
                                                                <button class="btn btn-sm btn-outline-danger py-0 px-2 w-100"
                                                                        @onclick="DeleteSelectedStep">
                                                                    <i class="fa-solid fa-trash-can me-1"></i>Удалить
                                                                </button>
                                                            </Authorized>
                                                        </AuthorizeView>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@if (activeTab == 1)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <input class="form-control" style="max-width:280px;" placeholder="Поиск..." @bind="productSearch" @bind:after="FilterProducts" />
        <AuthorizeView Roles="technologist">
            <Authorized>
                <button class="btn btn-primary btn-sm" @onclick="ShowAddProductModal">
                    <i class="fa-solid fa-plus me-1"></i>Добавить изделие
                </button>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="card">
        <div class="card-body p-0">
            @if (!filteredProducts.Any())
            {
                <div class="empty-state"><i class="fa-solid fa-box d-block"></i><div>Изделий не найдено</div></div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Код</th>
                            <th>Наименование</th>
                            <th>Тип</th>
                            <th>Маршрутов</th>
                            <th>Описание</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in filteredProducts)
                        {
                            <tr>
                                <td style="font-family:monospace;font-size:12px;">@p.Code</td>
                                <td style="font-weight:500;">@p.Name</td>
                                <td><span class="badge-status badge-new" style="font-size:11px;">@ProductTypeLabel(p.Type)</span></td>
                                <td>@p.TechRoutes.Count</td>
                                <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--tn-text-muted);">@p.Description</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                title="Создать МК" @onclick="() => ShowCreateRouteModal(p)">
                                            <i class="fa-solid fa-route"></i>
                                        </button>
                                        <AuthorizeView Roles="technologist">
                                            <Authorized>
                                                <button class="btn btn-sm btn-outline-primary py-0 px-2"
                                                        title="Редактировать" @onclick="() => ShowEditProductModal(p)">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@if (activeTab == 2)
{
    <div class="row g-2 mb-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Фильтр по изделию</label>
            <select class="form-select" @bind="timeNormFilter" @bind:after="LoadTimeNorms">
                <option value="0">Все изделия</option>
                @foreach (var p in allProducts)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="card">
        <div class="card-body p-0">
            @if (!timeNorms.Any())
            {
                <div class="empty-state"><i class="fa-solid fa-clock d-block"></i><div>Нормы времени не найдены</div></div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>№ шага</th>
                            <th>Операция</th>
                            <th>Изделие</th>
                            <th>Ресурс</th>
                            <th>Норма, мин</th>
                            <th>Источник</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in timeNorms)
                        {
                            <tr>
                                <td>@t.RouteStep.SequenceNum</td>
                                <td>@(t.RouteStep.Operation?.Name ?? t.RouteStep.Description ?? "—")</td>
                                <td>@(t.RouteStep.Route?.Product?.Name ?? "—")</td>
                                <td>@(t.Resource?.Name ?? "Общая")</td>
                                <td style="font-weight:600;">@t.NormValue</td>
                                <td>
                                    <span class="badge-status @(t.IsManual ? "badge-new" : "badge-processed")" style="font-size:11px;">
                                        @(t.IsManual ? "Ручная" : "Авто")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<!-- ═══════════════ Вкладка 4: Нормы материалов ═══════════════ -->
@if (activeTab == 3)
{
    <div class="row g-2 mb-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Фильтр по изделию</label>
            <select class="form-select" @bind="matNormFilter" @bind:after="LoadMatNorms">
                <option value="0">Все изделия</option>
                @foreach (var p in allProducts)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="card">
        <div class="card-body p-0">
            @if (!matNorms.Any())
            {
                <div class="empty-state"><i class="fa-solid fa-cubes d-block"></i><div>Нормы материалов не найдены</div></div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>№ шага</th>
                            <th>Операция</th>
                            <th>Изделие</th>
                            <th>Материал</th>
                            <th>Норма расхода</th>
                            <th>Ед. изм.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in matNorms)
                        {
                            <tr>
                                <td>@m.RouteStep.SequenceNum</td>
                                <td>@(m.RouteStep.Operation?.Name ?? m.RouteStep.Description ?? "—")</td>
                                <td>@(m.RouteStep.Route?.Product?.Name ?? "—")</td>
                                <td>@(m.Material?.Name ?? "—")</td>
                                <td style="font-weight:600;">@m.ConsumptionRate</td>
                                <td>@(m.Material?.Unit ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@if (nsiConfirm is not null)
{
    <div class="tn-backdrop" @onclick="() => nsiConfirm = null">
        <div class="tn-modal" @onclick:stopPropagation style="max-width:360px;text-align:center;padding:32px 28px;">
            <div style="font-size:44px;margin-bottom:16px;color:#dc2626;">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div style="font-size:16px;font-weight:600;margin-bottom:8px;">@nsiConfirm.Title</div>
            <div style="font-size:13px;color:var(--tn-text-muted);margin-bottom:24px;">Это действие нельзя отменить.</div>
            <div class="d-flex gap-2 justify-content-center">
                <button class="btn btn-outline-secondary" @onclick="() => nsiConfirm = null">Отмена</button>
                <button class="btn btn-danger" @onclick="RunNsiConfirm">
                    <i class="fa-solid fa-trash-can me-1"></i>Удалить
                </button>
            </div>
        </div>
    </div>
}

@if (showAddStepModal)
{
    <div class="tn-backdrop" @onclick="CloseModals">
        <div class="tn-modal" @onclick:stopPropagation style="max-width:560px;max-height:90vh;overflow-y:auto;">
            <div class="tn-modal-header">
                <h5>Добавить шаг маршрута</h5>
                <button class="btn-close" @onclick="CloseModals"></button>
            </div>

            <!-- Основные поля -->
            <div class="row g-2 mb-3">
                <div class="col-3">
                    <label class="form-label">№ шага</label>
