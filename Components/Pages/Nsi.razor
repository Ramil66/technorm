                    Создать маршрут (@lastMinerResult.Activities.Count оп.)
                </button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private static readonly (string, string, int)[] Tabs =
    [
        ("Маршрутные карты", "fa-solid fa-route",        0),
        ("Изделия",          "fa-solid fa-box",           1),
        ("Нормы времени",    "fa-solid fa-clock",         2),
        ("Нормы материалов", "fa-solid fa-scale-balanced",3),
    ];

    private int  activeTab    = 0;
    private int  currentUserId;

    // Tab 0 — Routes (per product)
    private int              routeProductId  = 0;
    private List<TechRoute>  productRoutes   = [];
    private int              expandedRouteId = 0;
    private List<RouteStep>  expandedRouteSteps = [];
    private bool             isLoadingSteps  = false;
    private TechRoute?       currentRoute;       // used by SaveStep
    private RouteStep?       selectedStep;

    // Tab 1 — Products
    private List<Product>    allProducts      = [];
    private List<Product>    filteredProducts = [];
    private string           productSearch    = "";
    private Product?         editingProduct;
    private bool             showProductModal;
    private bool             showCreateRouteModal;
    private Product?         routeForProduct;
    private string           newRouteName = "";
    private ProductForm      productForm  = new();

    // Tab 2 — Time norms
    private List<TimeNorm>   timeNorms    = [];
    private int              timeNormFilter;

    // Tab 3 — Mat norms
    private List<MaterialNorm> matNorms   = [];
    private int                matNormFilter;

    // Shared
    private List<Operation>  allOperations = [];
    private List<Resource>   allResources  = [];
    private List<Material>   allMaterials  = [];
    private bool             showAddStepModal;
    private bool             showEditStepModal;
    private int              editingStepId;
    private StepForm         stepForm = new();

    // Confirm modal
    private record NsiConfirm(string Title, Func<Task> Action);
    private NsiConfirm? nsiConfirm;

    // Inductive Miner state
    private bool          isMining         = false;
    private string?       minerError;
    private MinerResult?  lastMinerResult;
    private bool          showMinerConfirm = false;
    private bool          isSavingRoute    = false;

    // Route metrics cache: routeId → computed metrics
    private Dictionary<int, RouteMetrics> routeMetricsCache = [];

    private class RouteMetrics
    {
        public decimal TotalAvgMin   { get; set; }
        public int     StepCount     { get; set; }
        public int     ResourceCount { get; set; }
        public decimal Confidence    { get; set; }
        public List<(string Name, decimal Pct)> ResourceBreakdown { get; set; } = [];
    }

    private async Task RunNsiConfirm()
    {
        if (nsiConfirm is null) return;
        var action = nsiConfirm.Action;
        nsiConfirm = null;
        await action();
    }

    private class ProductForm
    {
        public string Code         { get; set; } = "";
        public string Name         { get; set; } = "";
        public string Type         { get; set; } = "product";
        public string? Description { get; set; }
    }

    private class StepTimeNormEntry
    {
        public int?    ResourceId { get; set; }
        public decimal NormValue  { get; set; }
    }

    private class StepMatNormEntry
    {
        public int?    MaterialId      { get; set; }
        public decimal ConsumptionRate { get; set; }
    }

    private class StepForm
    {
        public int     SequenceNum  { get; set; } = 1;
        public int?    OperationId  { get; set; }
        public string? Description  { get; set; }
        public List<StepTimeNormEntry> TimeNorms { get; set; } = [];
        public List<StepMatNormEntry>  MatNorms  { get; set; } = [];
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask;
        currentUserId = int.Parse(state.User.FindFirst("UserId")?.Value ?? "0");

        var t1 = ProductSvc.GetAllWithRoutesAsync();
        var t2 = OpSvc.GetAllAsync();
        var t3 = ResourceSvc.GetAllAsync();
        var t4 = MatSvc.GetAllAsync();
        await Task.WhenAll(t1, t2, t3, t4);

        allProducts      = t1.Result;
        allOperations    = t2.Result;
        allResources     = t3.Result;
        allMaterials     = t4.Result;
        filteredProducts = [.. allProducts];
    }

    private async Task SetTab(int tab)
    {
        activeTab = tab;
        if (tab == 2 && !timeNorms.Any()) await LoadTimeNorms();
        if (tab == 3 && !matNorms.Any())  await LoadMatNorms();
    }

    // ── Tab 0: Route cards ────────────────────────────────────────────────────

    private async Task LoadProductRoutes()
    {
        expandedRouteId    = 0;
        expandedRouteSteps = [];
        currentRoute       = null;
        selectedStep       = null;
        routeMetricsCache  = [];
        minerError         = null;
        if (routeProductId == 0) { productRoutes = []; return; }
        productRoutes = await RouteSvc.GetByProductAsync(routeProductId);
    }

    private async Task ToggleRoute(TechRoute route)
    {
        if (expandedRouteId == route.Id)
        {
            expandedRouteId    = 0;
            expandedRouteSteps = [];
            currentRoute       = null;
            selectedStep       = null;
            return;
        }
        expandedRouteId = route.Id;
        currentRoute    = route;
        selectedStep    = null;
        isLoadingSteps  = true;
        StateHasChanged();

        var full = await RouteSvc.GetByIdWithStepsAsync(route.Id);
        expandedRouteSteps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
        isLoadingSteps     = false;

        if (!routeMetricsCache.ContainsKey(route.Id))
            routeMetricsCache[route.Id] = ComputeMetrics(expandedRouteSteps);
    }

    private async Task SetDefaultRoute(TechRoute route)
    {
        await RouteSvc.PublishAsync(route.Id, currentUserId);
        productRoutes = await RouteSvc.GetByProductAsync(routeProductId);
        // Reload steps if this route is expanded
        if (expandedRouteId == route.Id)
        {
            var full = await RouteSvc.GetByIdWithStepsAsync(route.Id);
            expandedRouteSteps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
        }
    }

    private void DeleteRoute(TechRoute route)
    {
        nsiConfirm = new("Удалить маршрут?", async () =>
        {
            bool wasMain = route.Status == "published";
            await RouteSvc.DeleteAsync(route.Id);
            if (expandedRouteId == route.Id) { expandedRouteId = 0; expandedRouteSteps = []; currentRoute = null; }
            productRoutes = await RouteSvc.GetByProductAsync(routeProductId);
            // Auto-promote the first remaining route if the main was deleted
            if (wasMain && productRoutes.Any())
                await RouteSvc.PublishAsync(productRoutes[0].Id, currentUserId);
            productRoutes = await RouteSvc.GetByProductAsync(routeProductId);
        });
    }

    private void PrepareAddStep(TechRoute route)
    {
        currentRoute = route;
        stepForm = new StepForm { SequenceNum = expandedRouteSteps.Count + 1 };
        showAddStepModal = true;
    }

    private void SelectStep(RouteStep step) =>
        selectedStep = (selectedStep?.Id == step.Id) ? null : step;

    private void PrepareEditStep(RouteStep step)
    {
        editingStepId = step.Id;
        stepForm = new StepForm
        {
            SequenceNum = step.SequenceNum,
            OperationId = step.OperationId,
            Description = step.Description,
            TimeNorms   = step.TimeNorms.Select(tn => new StepTimeNormEntry
            {
                ResourceId = tn.ResourceId,
                NormValue  = tn.NormValue,
            }).ToList(),
            MatNorms = step.MaterialNorms.Select(mn => new StepMatNormEntry
            {
                MaterialId      = mn.MaterialId,
                ConsumptionRate = mn.ConsumptionRate,
            }).ToList(),
        };
        showEditStepModal = true;
    }

    private async Task SaveEditStep()
    {
        var stepToEdit = expandedRouteSteps.FirstOrDefault(s => s.Id == editingStepId);
        if (stepToEdit is null) return;

        stepToEdit.SequenceNum = stepForm.SequenceNum;
        stepToEdit.OperationId = stepForm.OperationId;
        stepToEdit.Description = stepForm.Description;
        await StepSvc.UpdateAsync(stepToEdit);

        foreach (var tn in stepToEdit.TimeNorms.ToList())
            await TimeNormSvc.DeleteAsync(tn.Id);
        foreach (var tn in stepForm.TimeNorms.Where(t => t.NormValue > 0))
            await TimeNormSvc.UpsertAsync(new TimeNorm
            {
                RouteStepId = editingStepId,
                ResourceId  = tn.ResourceId,
                NormValue   = tn.NormValue,
                IsManual    = true,
                UpdatedAt   = DateTime.UtcNow,
            });

        foreach (var mn in stepToEdit.MaterialNorms.ToList())
            await MatNormSvc.DeleteAsync(mn.Id);
        foreach (var mn in stepForm.MatNorms.Where(m => m.MaterialId.HasValue && m.ConsumptionRate > 0))
            await MatNormSvc.UpsertAsync(new MaterialNorm
            {
                RouteStepId     = editingStepId,
                MaterialId      = mn.MaterialId!.Value,
                ConsumptionRate = mn.ConsumptionRate,
            });

        if (currentRoute is not null)
        {
            var full = await RouteSvc.GetByIdWithStepsAsync(currentRoute.Id);
            expandedRouteSteps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
            routeMetricsCache[currentRoute.Id] = ComputeMetrics(expandedRouteSteps);
        }
        CloseModals();
    }

    private void DeleteStep(int stepId)
    {
        var deletedSeqNum = expandedRouteSteps.FirstOrDefault(s => s.Id == stepId)?.SequenceNum ?? 0;

        nsiConfirm = new("Удалить шаг?", async () =>
        {
            await StepSvc.DeleteAsync(stepId);
            if (selectedStep?.Id == stepId) selectedStep = null;
            if (currentRoute is not null)
            {
                var full = await RouteSvc.GetByIdWithStepsAsync(currentRoute.Id);
                expandedRouteSteps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];

                // Decrement SeqNum for all later steps when the deleted group becomes empty
                if (deletedSeqNum > 0 && !expandedRouteSteps.Any(s => s.SequenceNum == deletedSeqNum))
                {
                    foreach (var s in expandedRouteSteps.Where(s => s.SequenceNum > deletedSeqNum))
                    {
                        s.SequenceNum--;
                        await StepSvc.UpdateAsync(s);
                    }
                    full = await RouteSvc.GetByIdWithStepsAsync(currentRoute.Id);
                    expandedRouteSteps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
                }

                routeMetricsCache[currentRoute.Id] = ComputeMetrics(expandedRouteSteps);
            }
        });
    }

    private void DeleteSelectedStep()
    {
        if (selectedStep is null) return;
        DeleteStep(selectedStep.Id);
    }

    private async Task SaveStep()
    {
        if (currentRoute is null) return;
        var step = new RouteStep
        {
            RouteId     = currentRoute.Id,
            SequenceNum = stepForm.SequenceNum,
            OperationId = stepForm.OperationId,
            Description = stepForm.Description,
        };
        step = await StepSvc.CreateAsync(step);

        // Save time norms
        foreach (var tn in stepForm.TimeNorms.Where(t => t.NormValue > 0))
        {
            await TimeNormSvc.UpsertAsync(new TimeNorm
            {
                RouteStepId = step.Id,
                ResourceId  = tn.ResourceId,
                NormValue   = tn.NormValue,
                IsManual    = true,
                UpdatedAt   = DateTime.UtcNow,
            });
        }

        // Save material norms
        foreach (var mn in stepForm.MatNorms.Where(m => m.MaterialId.HasValue && m.ConsumptionRate > 0))
        {
            await MatNormSvc.UpsertAsync(new MaterialNorm
            {
                RouteStepId     = step.Id,
                MaterialId      = mn.MaterialId!.Value,
                ConsumptionRate = mn.ConsumptionRate,
            });
        }

        var full = await RouteSvc.GetByIdWithStepsAsync(currentRoute.Id);
        expandedRouteSteps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
        routeMetricsCache[currentRoute.Id] = ComputeMetrics(expandedRouteSteps);
        CloseModals();
    }

    private void AddTimeNormEntry() => stepForm.TimeNorms.Add(new StepTimeNormEntry());
    private void AddMatNormEntry()  => stepForm.MatNorms.Add(new StepMatNormEntry());

    // ── Inductive Miner / Auto-build ─────────────────────────────────────────────

    private async Task AutoBuildRoute()
    {
        if (routeProductId == 0) return;
        minerError = null;
        isMining   = true;
        StateHasChanged();

        try
        {
            lastMinerResult = await RouteBuildSvc.MineFromEventsAsync(routeProductId);
            if (!lastMinerResult.Success)
            {
                minerError      = lastMinerResult.ErrorMessage;
                lastMinerResult = null;
                return;
            }
            var product  = allProducts.FirstOrDefault(p => p.Id == routeProductId);
            newRouteName     = $"МК — {product?.Name} (авто)";
            showMinerConfirm = true;
        }
        finally
        {
            isMining = false;
        }
    }

    private async Task ConfirmBuildRoute()
    {
        if (lastMinerResult is null || string.IsNullOrWhiteSpace(newRouteName)) return;
        isSavingRoute = true;
        var confidence = lastMinerResult.OverallConfidence;

        try
        {
            var route = await RouteBuildSvc.BuildRouteFromMinerAsync(
                lastMinerResult, routeProductId, newRouteName.Trim(), currentUserId);

            showMinerConfirm = false;
            lastMinerResult  = null;

            productRoutes = await RouteSvc.GetByProductAsync(routeProductId);
            await ToggleRoute(route);

            // Enrich cached metrics with miner confidence
            if (routeMetricsCache.TryGetValue(route.Id, out var m))
                m.Confidence = confidence;
        }
        catch (Exception ex)
        {
            minerError = $"Ошибка создания маршрута: {ex.Message}";
        }
        finally
        {
            isSavingRoute = false;
        }
    }

    private void CancelMiner()
    {
        showMinerConfirm = false;
        lastMinerResult  = null;
    }

    private RouteMetrics ComputeMetrics(List<RouteStep> steps, decimal confidence = 0m)
    {
        var allNorms  = steps.SelectMany(s => s.TimeNorms).ToList();
        var totalTime = allNorms.Sum(tn => tn.NormValue);

        var resTotals = allNorms
            .GroupBy(tn => tn.Resource?.Name ?? "Общая")
            .ToDictionary(g => g.Key, g => g.Sum(tn => tn.NormValue));

        var breakdown = resTotals
            .Select(kv => (kv.Key,
                           Pct: totalTime > 0 ? Math.Round(kv.Value / totalTime * 100, 1) : 0m))
            .OrderByDescending(x => x.Pct)
            .ToList();

        return new RouteMetrics
        {
            TotalAvgMin       = Math.Round(totalTime, 1),
            StepCount         = steps.Count,
            ResourceCount     = allNorms.Where(t => t.Resource is not null)
                                        .Select(t => t.Resource!.Name).Distinct().Count(),
            Confidence        = confidence,
            ResourceBreakdown = breakdown,
        };
    }

