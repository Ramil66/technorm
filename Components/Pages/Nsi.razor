        filteredProducts = string.IsNullOrEmpty(productSearch)
            ? [.. allProducts]
            : allProducts.Where(p => p.Name.Contains(productSearch, StringComparison.OrdinalIgnoreCase)
                               || (p.Code?.Contains(productSearch, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
