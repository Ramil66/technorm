    private void PrepareEditStep(RouteStep step, int routeId)
    {
        editingStepId  = step.Id;
        editingRouteId = routeId;
        stepForm = new StepForm
        {
            SequenceNum = step.SequenceNum,
            OperationId = step.OperationId,
            Description = step.Description,
            TimeNorms   = step.TimeNorms.Select(tn => new StepTimeNormEntry { ResourceId = tn.ResourceId, NormValue = tn.NormValue }).ToList(),
            MatNorms    = step.MaterialNorms.Select(mn => new StepMatNormEntry { MaterialId = mn.MaterialId, ConsumptionRate = mn.ConsumptionRate }).ToList(),
        };
        showEditStepModal = true;
    }

    private async Task SaveStep()
    {
        if (currentRoute is null) return;
        var step = new RouteStep
        {
            RouteId     = currentRoute.Id,
            SequenceNum = stepForm.SequenceNum,
            OperationId = stepForm.OperationId,
            Description = stepForm.Description,
        };
        step = await StepSvc.CreateAsync(step);
        foreach (var tn in stepForm.TimeNorms.Where(t => t.NormValue > 0))
            await TimeNormSvc.UpsertAsync(new TimeNorm { RouteStepId = step.Id, ResourceId = tn.ResourceId, NormValue = tn.NormValue, IsManual = true, UpdatedAt = DateTime.UtcNow });
        foreach (var mn in stepForm.MatNorms.Where(m => m.MaterialId.HasValue && m.ConsumptionRate > 0))
            await MatNormSvc.UpsertAsync(new MaterialNorm { RouteStepId = step.Id, MaterialId = mn.MaterialId!.Value, ConsumptionRate = mn.ConsumptionRate });
        await AuditSvc.LogAsync(currentUserId, "Шаг маршрута добавлен",
            "RouteStep", step.Id,
            newValue: new { RouteId = currentRoute.Id, RouteName = currentRoute.Name, step.SequenceNum, step.Description });
        await RefreshRouteSteps(currentRoute.Id);
        CloseModals();
    }

    private async Task SaveEditStep()
    {
        routeStepsCache.TryGetValue(editingRouteId, out var steps);
        var stepToEdit = steps?.FirstOrDefault(s => s.Id == editingStepId);
        if (stepToEdit is null) return;

        stepToEdit.SequenceNum = stepForm.SequenceNum;
        stepToEdit.OperationId = stepForm.OperationId;
        stepToEdit.Description = stepForm.Description;
        await StepSvc.UpdateAsync(stepToEdit);

        foreach (var tn in stepToEdit.TimeNorms.ToList()) await TimeNormSvc.DeleteAsync(tn.Id);
        foreach (var tn in stepForm.TimeNorms.Where(t => t.NormValue > 0))
            await TimeNormSvc.UpsertAsync(new TimeNorm { RouteStepId = editingStepId, ResourceId = tn.ResourceId, NormValue = tn.NormValue, IsManual = true, UpdatedAt = DateTime.UtcNow });

        foreach (var mn in stepToEdit.MaterialNorms.ToList()) await MatNormSvc.DeleteAsync(mn.Id);
        foreach (var mn in stepForm.MatNorms.Where(m => m.MaterialId.HasValue && m.ConsumptionRate > 0))
            await MatNormSvc.UpsertAsync(new MaterialNorm { RouteStepId = editingStepId, MaterialId = mn.MaterialId!.Value, ConsumptionRate = mn.ConsumptionRate });

        await AuditSvc.LogAsync(currentUserId, "Шаг маршрута изменён",
            "RouteStep", editingStepId,
            newValue: new { stepToEdit.SequenceNum, stepToEdit.Description, RouteId = editingRouteId });
        await RefreshRouteSteps(editingRouteId);
        CloseModals();
    }

    private void DeleteStep(int stepId, int routeId)
    {
        routeStepsCache.TryGetValue(routeId, out var steps);
        var deletedSeqNum = steps?.FirstOrDefault(s => s.Id == stepId)?.SequenceNum ?? 0;
        nsiConfirm = new("Удалить шаг?", async () =>
        {
            await AuditSvc.LogAsync(currentUserId, "Шаг маршрута удалён",
                "RouteStep", stepId, oldValue: new { RouteId = routeId, SeqNum = deletedSeqNum });
            await StepSvc.DeleteAsync(stepId);
            if (selectedStep?.Id == stepId) { selectedStep = null; selectedStepRouteId = 0; }
            var full     = await RouteSvc.GetByIdWithStepsAsync(routeId);
            var newSteps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
            if (deletedSeqNum > 0 && !newSteps.Any(s => s.SequenceNum == deletedSeqNum))
            {
                foreach (var s in newSteps.Where(s => s.SequenceNum > deletedSeqNum))
                {
                    s.SequenceNum--;
                    await StepSvc.UpdateAsync(s);
                }
                full     = await RouteSvc.GetByIdWithStepsAsync(routeId);
                newSteps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
            }
            routeStepsCache[routeId]   = newSteps;
            routeMetricsCache[routeId] = ComputeMetrics(newSteps);
            var mainRoute = productRoutes.FirstOrDefault(r => r.Status == "published");
            if (mainRoute?.Id == routeId) mainRouteSteps = newSteps;
        });
    }

    private void DeleteSelectedStep()
    {
        if (selectedStep is null) return;
        DeleteStep(selectedStep.Id, selectedStepRouteId);
    }

    private async Task RefreshRouteSteps(int routeId)
    {
        var full  = await RouteSvc.GetByIdWithStepsAsync(routeId);
        var steps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
        routeStepsCache[routeId]   = steps;
        routeMetricsCache[routeId] = ComputeMetrics(steps);
        var mainRoute = productRoutes.FirstOrDefault(r => r.Status == "published");
        if (mainRoute?.Id == routeId) mainRouteSteps = steps;
    }


