    private async Task AutoBuildRoute()
    {
        if (routeProductId == 0) return;
        minerError       = null;
        lastMinerResult  = null;
        isMining         = true;
        showMinerConfirm = true;
        StateHasChanged();
        try
        {
            lastMinerResult = await RouteBuildSvc.MineFromEventsAsync(routeProductId);
            if (!lastMinerResult.Success)
            {
                minerError       = lastMinerResult.ErrorMessage;
                lastMinerResult  = null;
                showMinerConfirm = false;
                return;
            }
            var product       = allProducts.FirstOrDefault(p => p.Id == routeProductId);
            newRouteName      = $"МК — {product?.Name} (авто)";
            routeNameConflict = false;
            CheckRouteName();
        }
        finally
        {
            isMining = false;
        }
    }

    private async Task ConfirmBuildRoute()
    {
        if (lastMinerResult is null || string.IsNullOrWhiteSpace(newRouteName)) return;
        isSavingRoute = true;
        var confidence = lastMinerResult.OverallConfidence;
        var eventCount = lastMinerResult.TotalEvents;
        try
        {
            var routes = await RouteBuildSvc.BuildRouteFromMinerAsync(
                lastMinerResult, routeProductId, newRouteName.Trim(), currentUserId);

            foreach (var route in routes)
                await AuditSvc.LogAsync(currentUserId, "Маршрут построен из событий (Inductive Miner)",
                    "TechRoute", route.Id,
                    newValue: new { route.Name, Steps = lastMinerResult?.Activities.Count, Events = eventCount, Confidence = confidence });

            productMinerCache[routeProductId] = lastMinerResult!;
            showMinerConfirm = false;
            lastMinerResult  = null;

            allProducts   = await ProductSvc.GetAllWithRoutesAsync();
            productRoutes = await RouteSvc.GetByProductAsync(routeProductId);

            foreach (var route in routes)
            {
                expandedRouteIds.Add(route.Id);
                loadingRouteIds.Add(route.Id);
            }
            StateHasChanged();

            foreach (var route in routes)
            {
                var full  = await RouteSvc.GetByIdWithStepsAsync(route.Id);
                var steps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
                routeStepsCache[route.Id]   = steps;
                var m = ComputeMetrics(steps);
                m.Confidence = confidence;
                routeMetricsCache[route.Id] = m;
                loadingRouteIds.Remove(route.Id);
            }
        }
        catch (Exception ex) { minerError = $"Ошибка создания маршрута: {ex.Message}"; }
        finally { isSavingRoute = false; }
    }

    private int GetVariantCount() =>
        lastMinerResult?.Stages.Aggregate(1, (acc, s) => acc * s.Count) ?? 1;

