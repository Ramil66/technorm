@if (showMinerConfirm)
{
    <div class="tn-backdrop" @onclick="CancelMiner">
        <div class="tn-modal" @onclick:stopPropagation style="max-width:580px;">
            <div class="tn-modal-header">
                <h5>
                    <i class="fa-solid fa-wand-magic-sparkles me-2" style="color:var(--tn-blue);"></i>
                    Результат анализа журнала событий
                </h5>
            </div>

            @if (isMining)
            {
                <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px 24px;gap:16px;">
                    <div class="spinner-border text-primary" style="width:2.5rem;height:2.5rem;" role="status"></div>
                    <div style="font-size:14px;color:var(--tn-text-muted);font-weight:500;">Идет обработка событий...</div>
                </div>
                <div class="tn-modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelMiner">Отмена</button>
                </div>
            }
            else if (lastMinerResult is not null)
            {
            <div class="row g-2 mb-3">
                <div class="col-3"><div class="stat-mini"><div class="stat-mini-val">@lastMinerResult.TotalCases</div><div class="stat-mini-lbl">трасс (дел)</div></div></div>
                <div class="col-3"><div class="stat-mini"><div class="stat-mini-val">@lastMinerResult.TotalEvents</div><div class="stat-mini-lbl">событий</div></div></div>
                <div class="col-3"><div class="stat-mini"><div class="stat-mini-val">@lastMinerResult.Activities.Count</div><div class="stat-mini-lbl">операций</div></div></div>
                <div class="col-3"><div class="stat-mini"><div class="stat-mini-val">@lastMinerResult.OverallConfidence%</div><div class="stat-mini-lbl">ЧИ (ср.)</div></div></div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <div class="stat-mini">
                        <div class="stat-mini-val" style="color:@(lastMinerResult.Coverage >= 90 ? "#16a34a" : lastMinerResult.Coverage >= 70 ? "#d97706" : "#dc2626");">
                            @lastMinerResult.Coverage%
                        </div>
                        <div class="stat-mini-lbl">покрытие событий</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="stat-mini">
                        <div class="stat-mini-val" style="color:@(lastMinerResult.RareTransitionCount == 0 ? "#16a34a" : "#d97706");">
                            @lastMinerResult.RareTransitionCount
                        </div>
                        <div class="stat-mini-lbl">редких переходов</div>
                    </div>
                </div>
            </div>

            @if (lastMinerResult.Transitions.Any())
            {
                <details style="margin-bottom:12px;">
                    <summary style="font-size:12px;font-weight:600;cursor:pointer;color:var(--tn-text-muted);user-select:none;margin-bottom:6px;">
                        <i class="fa-solid fa-diagram-project me-1"></i>
                        Переходы между операциями (@lastMinerResult.Transitions.Count)
                        @if (lastMinerResult.RareTransitionCount > 0)
                        {
                            <span style="margin-left:6px;background:#fef3c7;color:#d97706;border-radius:4px;padding:1px 6px;font-size:11px;">
                                @lastMinerResult.RareTransitionCount редких
                            </span>
                        }
                    </summary>
                    <div style="max-height:180px;overflow-y:auto;border:1px solid var(--tn-border);border-radius:8px;">
                        <table class="table table-sm mb-0" style="font-size:12px;">
                            <thead style="position:sticky;top:0;background:#f8fafc;z-index:1;">
                                <tr>
                                    <th>Из операции</th>
                                    <th>В операцию</th>
                                    <th style="width:55px;">Кол-во</th>
                                    <th style="width:70px;">Уверен.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in lastMinerResult.Transitions)
                                {
                                    <tr style="@(t.IsRare ? "background:#fffbeb;" : "")">
                                        <td style="color:var(--tn-text-muted);">@t.From</td>
                                        <td style="font-weight:500;">@t.To</td>
                                        <td>@t.Count</td>
                                        <td>
                                            <span style="color:@(t.Confidence >= 50 ? "#16a34a" : t.Confidence >= 10 ? "#d97706" : "#dc2626");font-weight:600;">
                                                @t.Confidence%
                                            </span>
                                            @if (t.IsRare)
                                            {
                                                <i class="fa-solid fa-triangle-exclamation ms-1" style="color:#d97706;font-size:10px;" title="Редкий переход"></i>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
            <div style="max-height:280px;overflow-y:auto;border:1px solid var(--tn-border);border-radius:8px;margin-bottom:16px;">
                <table class="table table-sm mb-0">
                    <thead style="position:sticky;top:0;background:#f8fafc;z-index:1;">
                        <tr>
                            <th style="width:32px;">#</th><th>Операция</th>
                            <th style="width:60px;">ЧИ%</th><th style="width:95px;">Ср. мин.</th><th>Ресурсы</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < lastMinerResult.Activities.Count; i++)
                        {
                            var act = lastMinerResult.Activities[i];
                            <tr>
                                <td style="color:var(--tn-text-muted);">@(i + 1)</td>
                                <td style="font-weight:500;">@act.Name</td>
                                <td><span style="color:@(act.Confidence >= 80 ? "#16a34a" : act.Confidence >= 50 ? "#d97706" : "#dc2626");font-weight:600;">@act.Confidence%</span></td>
                                <td style="font-family:monospace;">@(act.AvgDurationMin > 0 ? act.AvgDurationMin.ToString("F1") : "—")</td>
                                <td style="font-size:11px;color:var(--tn-text-muted);">@(act.Resources.Any() ? string.Join(", ", act.Resources.Take(2)) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (GetVariantCount() > 1)
            {
                <div class="alert alert-info py-2 mb-3" style="font-size:12px;">
                    <i class="fa-solid fa-code-branch me-1"></i>
                    Обнаружено <strong>@GetVariantCount()</strong> параллельных варианта — будет создано по маршруту для каждого.
                </div>
            }
            <div class="mb-1">
                <label class="form-label">Название маршрута</label>
                <input class="form-control" @bind="newRouteName" @bind:event="oninput" @bind:after="CheckRouteName" />
            </div>
            @if (routeNameConflict)
            {
                <div class="text-warning small mb-3">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Маршрут с таким именем уже существует
                </div>
            }
            else { <div class="mb-3"></div> }
            <div class="tn-modal-footer">
                <button class="btn btn-secondary" @onclick="CancelMiner">Отмена</button>
                <button class="btn btn-primary" @onclick="ConfirmBuildRoute" disabled="@(isSavingRoute || routeNameConflict)">
                    @if (isSavingRoute) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> }
                    <i class="fa-solid fa-floppy-disk me-1"></i>
                    Создать @(GetVariantCount() > 1 ? $"{GetVariantCount()} маршрута" : "маршрут") (@lastMinerResult.Activities.Count оп.)
                </button>
            </div>
            }
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private int currentUserId;

    private List<Product> allProducts     = [];
    private Product?      selectedProduct;
    private bool          showProductDropdown;
    private string SelectedProductName => selectedProduct?.Name ?? "— выберите изделие —";

    private int             routeProductId   = 0;
    private bool            isPciCalculating = false;
    private List<TechRoute> productRoutes    = [];
    private HashSet<int>    expandedRouteIds   = [];
    private HashSet<int>    loadingRouteIds    = [];
    private HashSet<int>    rebuildingRouteIds = [];
    private Dictionary<int, List<RouteStep>> routeStepsCache   = [];
    private Dictionary<int, RouteMetrics>    routeMetricsCache = [];
    private List<RouteStep>                  mainRouteSteps    = [];
    private TechRoute?                       currentRoute;
    private RouteStep?                       selectedStep;
    private int                              selectedStepRouteId;

    private bool     showProductInfoModal;
    private Product? infoProduct;
    private bool     showProductModal;
    private Product? editingProduct;
    private ProductForm productForm = new();

    private bool      showRenameRouteModal;
    private TechRoute? renamingRoute;
    private string     renameValue   = "";
    private bool       renameConflict;

    private bool     showCreateRouteModal;
    private Product? routeForProduct;
    private string   newRouteName = "";
    private bool     routeNameConflict;

    private bool     showAddStepModal;
    private bool     showEditStepModal;
    private int      editingStepId;
    private int      editingRouteId;
    private StepForm stepForm = new();

    private List<Operation> allOperations = [];
    private List<Resource>  allResources  = [];
    private List<Material>  allMaterials  = [];

    private record NsiConfirm(string Title, Func<Task> Action);
    private NsiConfirm? nsiConfirm;

    private bool         isMining         = false;
    private string?      minerError;
    private MinerResult? lastMinerResult;
    private bool         showMinerConfirm = false;
    private bool         isSavingRoute    = false;
    private bool         isExporting      = false;

    private Dictionary<int, MinerResult> productMinerCache = [];

    private bool showAnalyticsModal = false;
    private bool analyticsLoading   = false;
    private ProductAnalyticsData? analyticsData;

    private enum DiffLevel { None, FullDiff, NormsDiff }

    private DiffLevel GetStepDiff(RouteStep step)
    {
        if (!mainRouteSteps.Any()) return DiffLevel.None;
        var mainStep = mainRouteSteps.FirstOrDefault(s => s.SequenceNum == step.SequenceNum);
        if (mainStep is null) return DiffLevel.FullDiff;

        bool opDiffers;
        if (step.OperationId is not null && mainStep.OperationId is not null)
            opDiffers = step.OperationId != mainStep.OperationId;
        else if (step.OperationId is null && mainStep.OperationId is null)
            opDiffers = step.Description != mainStep.Description;
        else
            opDiffers = true;

        if (opDiffers) return DiffLevel.FullDiff;

        var stepNorms = step.TimeNorms
            .Select(t => (t.ResourceId, Math.Round(t.NormValue, 2)))
            .OrderBy(x => x.ResourceId).ToList();
        var mainNorms = mainStep.TimeNorms
            .Select(t => (t.ResourceId, Math.Round(t.NormValue, 2)))
            .OrderBy(x => x.ResourceId).ToList();

        if (!stepNorms.SequenceEqual(mainNorms)) return DiffLevel.NormsDiff;

        return DiffLevel.None;
    }

    private class RouteMetrics
    {
        public decimal TotalAvgMin    { get; set; }
        public int     StepCount      { get; set; }
        public int     ResourceCount  { get; set; }
        public int     MaterialCount  { get; set; }
        public decimal TotalConsumption { get; set; }
        public decimal Confidence     { get; set; }
        public List<(string Name, decimal Pct)> ResourceBreakdown { get; set; } = [];
    }
    private class ProductForm
    {
        public string  Code        { get; set; } = "";
        public string  Name        { get; set; } = "";
        public string  Type        { get; set; } = "product";
        public string? Description { get; set; }
    }
    private class StepTimeNormEntry { public int? ResourceId { get; set; } public decimal NormValue { get; set; } }
    private class StepMatNormEntry  { public int? MaterialId { get; set; } public decimal ConsumptionRate { get; set; } }
    private class StepForm
    {
        public int     SequenceNum  { get; set; } = 1;
        public int?    OperationId  { get; set; }
        public string? Description  { get; set; }
        public List<StepTimeNormEntry> TimeNorms { get; set; } = [];
        public List<StepMatNormEntry>  MatNorms  { get; set; } = [];
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask;
        currentUserId = int.Parse(state.User.FindFirst("UserId")?.Value ?? "0");

        var t1 = ProductSvc.GetAllWithRoutesAsync();
        var t2 = OpSvc.GetAllAsync();
        var t3 = ResourceSvc.GetAllAsync();
        var t4 = MatSvc.GetAllAsync();
        await Task.WhenAll(t1, t2, t3, t4);

        allProducts   = t1.Result;
        allOperations = t2.Result;
        allResources  = t3.Result;
        allMaterials  = t4.Result;

        if (allProducts.Any())
        {
            selectedProduct = allProducts[0];
            routeProductId  = selectedProduct.Id;
