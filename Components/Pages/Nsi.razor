    private RouteMetrics ComputeMetrics(List<RouteStep> steps, decimal confidence = 0m)
    {
        var allNorms  = steps.SelectMany(s => s.TimeNorms).ToList();
        var totalTime = allNorms.Sum(tn => tn.NormValue);
        var resTotals = allNorms.GroupBy(tn => tn.Resource?.Name ?? "Общая")
                                .ToDictionary(g => g.Key, g => g.Sum(tn => tn.NormValue));
        var breakdown = resTotals
            .Select(kv => (kv.Key, Pct: totalTime > 0 ? Math.Round(kv.Value / totalTime * 100, 1) : 0m))
            .OrderByDescending(x => x.Pct).ToList();
        return new RouteMetrics
        {
            TotalAvgMin       = Math.Round(totalTime, 1),
            StepCount         = steps.Count,
            ResourceCount     = allNorms.Where(t => t.Resource is not null).Select(t => t.Resource!.Name).Distinct().Count(),
            Confidence        = confidence,
            ResourceBreakdown = breakdown,
        };
    }

    private RenderFragment StepCardInner(RouteStep step, string sName, decimal tot, bool sel, int routeId, DiffLevel diff) =>
        @<text>
            <div class="mk-step-num">Операция @step.SequenceNum</div>
            <div class="mk-step-name" title="@sName">@TruncText(sName, 24)</div>
            @if (step.Operation?.Code is not null)
            {
                <div class="mk-step-code">@step.Operation.Code</div>
            }
            @if (step.TimeNorms.Any())
            {
                <div class="mk-step-divider"></div>
                <div class="mk-step-norms-section @(diff == DiffLevel.NormsDiff ? "has-diff" : "")">
                    @foreach (var tn in step.TimeNorms.OrderByDescending(t => t.NormValue))
                    {
                        var resPct = tot > 0 ? (int)Math.Round(tn.NormValue / tot * 100) : 0;
                        <div class="mk-step-resource">
                            <i class="fa-solid fa-gear" style="flex-shrink:0;font-size:10px;"></i>
                            <span class="mk-res-name">@(tn.Resource?.Name ?? "Общая")</span>
                            @if (step.TimeNorms.Count > 1) { <span class="mk-res-pct">@resPct%</span> }
                        </div>
                        <div class="mk-step-time">
                            <i class="fa-regular fa-clock" style="flex-shrink:0;font-size:10px;"></i>
                            @tn.NormValue мин / 1 ед.
                        </div>
                    }
                </div>
            }
            else { <div class="mk-step-no-norm">Нормы не заданы</div> }
            @if (step.MaterialNorms.Any())
            {
                <div class="mk-step-divider"></div>
                <div class="mk-step-norms-section">
                    @foreach (var mn in step.MaterialNorms.OrderByDescending(m => m.ConsumptionRate))
                    {
                        <div class="mk-step-resource">
                            <i class="fa-solid fa-cubes" style="flex-shrink:0;font-size:10px;color:#94a3b8;"></i>
                            <span class="mk-res-name">@(mn.Material?.Name ?? "—")</span>
                        </div>
                        <div class="mk-step-time">
                            <i class="fa-solid fa-scale-balanced" style="flex-shrink:0;font-size:10px;color:#94a3b8;"></i>
                            @mn.ConsumptionRate @(mn.Material?.Unit ?? "ед.")
                        </div>
                    }
                </div>
            }
            @if (sel)
            {
                <div @onclick:stopPropagation style="margin-top:8px;display:flex;flex-direction:column;gap:4px;">
                    <AuthorizeView Roles="technologist">
                        <Authorized>
                            <button class="btn btn-sm btn-outline-primary py-0 px-2 w-100"
                                    @onclick="() => PrepareEditStep(step, routeId)">
                                <i class="fa-solid fa-pen me-1"></i>Редактировать
                            </button>
                            <button class="btn btn-sm btn-outline-danger py-0 px-2 w-100"
                                    @onclick="DeleteSelectedStep">
                                <i class="fa-solid fa-trash-can me-1"></i>Удалить
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            }
        </text>;

    private async Task ToggleAutoUpdate(TechRoute route, bool value)
    {
        route.IsAutoUpdate = value;
        await RouteSvc.UpdateAsync(route);
        var pr = productRoutes.FirstOrDefault(r => r.Id == route.Id);
        if (pr is not null) pr.IsAutoUpdate = value;
    }

    private async Task RebuildRoute(TechRoute route)
    {
        if (!route.SourceEventCount.HasValue) return;
        rebuildingRouteIds.Add(route.Id);
        expandedRouteIds.Add(route.Id);
        StateHasChanged();
        try
        {
            await RouteBuildSvc.ManualRebuildAsync(route.Id, currentUserId);
            await AuditSvc.LogAsync(currentUserId, "Маршрут перестроен из событий",
                "TechRoute", route.Id, newValue: new { route.Name });
            var full  = await RouteSvc.GetByIdWithStepsAsync(route.Id);
            var steps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
            routeStepsCache[route.Id]   = steps;
            routeMetricsCache[route.Id] = ComputeMetrics(steps);
            if (full is not null)
            {
                route.UpdatedAt        = full.UpdatedAt;
                route.SourceEventCount = full.SourceEventCount;
            }
        }
        finally
        {
            rebuildingRouteIds.Remove(route.Id);
        }
    }

    private static string TruncText(string s, int max) => s.Length <= max ? s : s[..max] + "…";

    private static string StatusLabel(string s) => s switch
    {
        "published" => "Опубликован",
        "archived"  => "Архив",
        _           => "Черновик",
    };

    private static string ProductTypeLabel(string t) => t switch
    {
        "product"       => "Изделие",
        "semi_finished" => "Полуфабрикат",
        "material"      => "Материал",
        _               => t,
    };
