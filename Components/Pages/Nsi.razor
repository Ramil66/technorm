@page "/nsi"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ITechRouteService RouteSvc
@inject IRouteStepService StepSvc
@inject IProductService ProductSvc
@inject ITimeNormService TimeNormSvc
@inject IMaterialNormService MatNormSvc
@inject IResourceService ResourceSvc
@inject IMaterialService MatSvc
@inject IOperationService OpSvc
@inject IRouteBuilderService RouteBuildSvc
@inject IAuditLogService AuditSvc
@inject IAnalyticsService AnalyticsSvc
@inject IConformanceCheckingService ConformanceSvc
@inject IJSRuntime JS
@using System.Text.Json
@using TechNormBlazor.Services.Analytics

<PageTitle>НСИ — ТехНорм</PageTitle>

<div class="page-header">
    <h1><i class="fa-solid fa-route" style="color:var(--tn-blue);margin-right:10px;font-size:18px;"></i>Маршрутные карты</h1>
</div>

<div class="mk-canvas">

    <div style="display:flex;gap:16px;flex-wrap:wrap;flex-shrink:0;align-items:flex-start;width:100%;">

        <div class="mk-topbar" style="flex:none;width:fit-content;">
            <div class="d-flex align-items-center gap-2 flex-wrap">

                <div style="position:relative;">
                    <button class="product-picker-toggle" @onclick="ToggleProductDropdown">
                        <i class="fa-solid fa-box" style="font-size:11px;color:var(--tn-blue);"></i>
                        <span style="max-width:220px;overflow:hidden;text-overflow:ellipsis;">@SelectedProductName</span>
                        <i class="fa-solid fa-chevron-down" style="font-size:9px;color:var(--tn-text-muted);"></i>
                    </button>

                    @if (showProductDropdown)
                    {
                        <div style="position:fixed;inset:0;z-index:999;" @onclick="CloseProductDropdown"></div>
                        <div class="product-picker-menu">
                            @foreach (var p in allProducts)
                            {
                                <div class="product-picker-item @(routeProductId == p.Id ? "selected" : "")">
                                    <span class="product-picker-name" @onclick="() => SelectProduct(p)">
                                        @p.Name
                                        @if (p.TechRoutes.Count > 0)
                                        {
                                            <small style="color:var(--tn-text-muted);font-weight:400;margin-left:4px;">
                                                (@p.TechRoutes.Count)
                                            </small>
                                        }
                                    </span>
                                    <div class="product-picker-actions">
                                        <button title="Информация об изделии"
                                                @onclick:stopPropagation @onclick="() => ShowProductInfo(p)">
                                            <i class="fa-solid fa-circle-question"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div style="width:1px;height:26px;background:var(--tn-border);flex-shrink:0;"></div>

                <AuthorizeView Roles="technologist">
                    <Authorized>
                        <button class="btn btn-sm btn-outline-primary" title="Добавить изделие"
                                @onclick="ShowAddProductModal">
                            <i class="fa-solid fa-plus me-1"></i>Новое изделие
                        </button>
                    </Authorized>
                </AuthorizeView>

                @if (routeProductId > 0 && productRoutes.Any())
                {
                    <span style="font-size:12px;color:var(--tn-text-muted);">
                        <strong>@productRoutes.Count</strong> МК
                    </span>
                }
                @if (isPciCalculating)
                {
                    <span style="font-size:12px;color:#94a3b8;display:flex;align-items:center;gap:4px;">
                        <span class="spinner-border spinner-border-sm" style="width:12px;height:12px;border-width:2px;"></span>
                        PCI считается...
                    </span>
                }
                else if (routeProductId > 0 && productRoutes.FirstOrDefault(r => r.Status == "published") is { LastPci: not null } pciRoute)
                {
                    <span style="font-size:12px;font-weight:600;color:@PciColor(pciRoute.LastPciStatus);"
                          title="@PciTooltip(pciRoute)">
                        <i class="fa-solid fa-gauge-high" style="font-size:10px;"></i>
                        PCI&nbsp;@pciRoute.LastPci.Value.ToString("N1")%
                    </span>
                }

                <div style="width:1px;height:26px;background:var(--tn-border);flex-shrink:0;"></div>

                <button class="btn btn-sm btn-outline-secondary"
                        title="@(routeProductId == 0 ? "Выберите изделие" : "Аналитика изделия")"
                        disabled="@(routeProductId == 0)"
                        @onclick="OpenAnalyticsModal">
                    <i class="fa-solid fa-chart-line me-1"></i>Аналитика изделия
                </button>
            </div>
        </div>

        @if (routeProductId > 0)
        {
            <div class="mk-topbar" style="flex-shrink:0;align-self:flex-start;margin-left:auto;">
                <div class="d-flex gap-2 align-items-center">
                    <AuthorizeView Roles="technologist">
                        <Authorized>
                            <button class="btn btn-primary btn-sm" @onclick="AutoBuildRoute" disabled="@isMining">
                                @if (isMining)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i>
                                }
                                Построить из событий
                            </button>
                            <button class="btn btn-outline-primary btn-sm" @onclick="ShowCreateRouteModalFromTab0">
                                <i class="fa-solid fa-plus me-1"></i>Создать вручную
                            </button>
                        </Authorized>
                    </AuthorizeView>
                    @if (allProducts.Any(p => p.TechRoutes.Any(r => r.Status == "published")))
                    {
                        <button class="btn btn-outline-success btn-sm" @onclick="ExportPublishedNsi"
                                title="Экспортировать опубликованные маршрутные карты всех изделий в JSON" disabled="@isExporting">
                            @if (isExporting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            else
                            {
                                <i class="fa-solid fa-file-export me-1"></i>
                            }
                            Экспорт
                        </button>
                    }
                </div>
            </div>
        }
    </div>

    @if (minerError is not null)
    {
        <div class="alert alert-danger py-2 mb-0" style="font-size:12px;flex-shrink:0;">
            <i class="fa-solid fa-circle-exclamation me-1"></i>@minerError
        </div>
    }

    <div class="mk-routes-area">
        @if (routeProductId == 0)
        {
            <div class="empty-state" style="border:none;padding-top:80px;">
                <i class="fa-solid fa-diagram-project d-block" style="opacity:.2;"></i>
                <div>Выберите изделие для просмотра маршрутных карт</div>
            </div>
        }
        else if (!productRoutes.Any())
        {
            <div class="empty-state" style="border:none;padding-top:80px;">
                <i class="fa-solid fa-route d-block" style="opacity:.2;"></i>
                <div>Маршрутных карт нет</div>
                <div style="font-size:12px;color:var(--tn-text-muted);margin-top:8px;">
                    Загрузите события и нажмите «Построить из событий»
                </div>
            </div>
        }
        else
        {
            @foreach (var route in productRoutes
                .OrderByDescending(r => r.Status == "published")
                .ThenByDescending(r => r.Version))
            {
                bool isExpanded = expandedRouteIds.Contains(route.Id);
                bool isMain     = route.Status == "published";
                bool isLoading  = loadingRouteIds.Contains(route.Id);
                routeStepsCache.TryGetValue(route.Id, out var routeSteps);
                routeMetricsCache.TryGetValue(route.Id, out var metrics);
                productMinerCache.TryGetValue(routeProductId, out var routeMiner);

                <div class="mk-route-block @(isMain ? "mk-route-block-main" : "")">

                    <div class="mk-route-header" @onclick="() => ToggleRoute(route)">

                        <div class="mk-route-row-main">
                            <div class="route-radio @(isMain ? "active" : "")" style="flex-shrink:0;"></div>
                            <span class="mk-route-num" title="@route.Name">@TruncText(route.Name, 36)</span>

                            @if (isMain)
                            {
                                <span class="mk-badge mk-badge-main">
                                    <i class="fa-solid fa-star me-1" style="font-size:9px;"></i>Основной
                                </span>
                            }
                            else
                            {
                                <span class="mk-badge mk-badge-alt">@StatusLabel(route.Status)</span>
                            }

                            @if (metrics is not null)
                            {
                                @if (metrics.TotalAvgMin > 0)
                                {
                                    <span class="mk-metric"><i class="fa-regular fa-clock"></i>@metrics.TotalAvgMin мин.</span>
                                }
                                <span class="mk-metric"><i class="fa-solid fa-list-ol"></i>@metrics.StepCount оп.</span>
                                @if (metrics.ResourceCount > 0)
                                {
                                    <span class="mk-metric"><i class="fa-solid fa-screwdriver-wrench"></i>@metrics.ResourceCount рес.</span>
                                }
                                @if (metrics.MaterialCount > 0)
                                {
                                    <span class="mk-metric"><i class="fa-solid fa-cubes"></i>@metrics.MaterialCount мат.</span>
                                }
                                @if (metrics.Confidence > 0)
                                {
                                    <span class="mk-metric"><i class="fa-solid fa-percent"></i>ЧИ @metrics.Confidence%</span>
                                }
                            }
                            @if (routeMiner is not null && route.SourceEventCount.HasValue)
                            {
                                <span class="mk-metric" title="Покрытие событий">
                                    <i class="fa-solid fa-chart-pie"></i>@routeMiner.Coverage%
                                </span>
                                @if (routeMiner.RareTransitionCount > 0)
                                {
                                    <span class="mk-metric" style="color:#d97706;" title="Редкие переходы DFG">
                                        <i class="fa-solid fa-triangle-exclamation"></i>@routeMiner.RareTransitionCount ред.
                                    </span>
                                }
                            }

                            <div class="ms-auto d-flex gap-1 align-items-center" @onclick:stopPropagation>
                                @if (!isMain)
                                {
                                    <AuthorizeView Roles="technologist">
                                        <Authorized>
                                            <button class="btn btn-sm btn-outline-primary py-0 px-2"
                                                    title="Сделать основным" @onclick="() => SetDefaultRoute(route)">
                                                <i class="fa-solid fa-star"></i>
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                }
                                <AuthorizeView Roles="technologist">
                                    <Authorized>
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                title="Переименовать" @onclick="() => PrepareRenameRoute(route)">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary py-0 px-2"
                                                title="Добавить шаг" @onclick="() => PrepareAddStep(route)">
                                            <i class="fa-solid fa-plus"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                title="Дублировать" @onclick="() => DuplicateRoute(route)">
                                            <i class="fa-solid fa-copy"></i>
                                        </button>
                                        @if (route.SourceEventCount.HasValue)
                                        {
                                            <button class="btn btn-sm btn-outline-success py-0 px-2"
                                                    title="Перестроить маршрут из событий"
                                                    @onclick="() => RebuildRoute(route)"
                                                    disabled="@rebuildingRouteIds.Contains(route.Id)">
                                                @if (rebuildingRouteIds.Contains(route.Id))
                                                {
                                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                                }
                                                else
                                                {
                                                    <i class="fa-solid fa-rotate"></i>
                                                }
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-outline-danger py-0 px-2"
                                                title="Удалить маршрут" @onclick="() => DeleteRoute(route)">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                            <i class="fa-solid @(isExpanded ? "fa-chevron-up" : "fa-chevron-down")"
                               style="color:var(--tn-text-muted);flex-shrink:0;"></i>
                        </div>

                        <div class="mk-route-row-meta">
                            <span class="mk-route-meta-item">
                                <i class="fa-regular fa-calendar" style="font-size:10px;"></i>
                                Создан: @route.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </span>
                            <span class="mk-route-meta-item">
                                <i class="fa-solid fa-pen-to-square" style="font-size:10px;"></i>
                                Обновлён: @route.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </span>
                            <span class="mk-route-meta-item">
                                <i class="fa-solid fa-database" style="font-size:10px;"></i>
                                Источник: @(route.SourceEventCount.HasValue ? $"{route.SourceEventCount} событий" : "ручной ввод")
                            </span>
                        </div>
                    </div>

                    @if (isExpanded)
                    {
                        @if (isLoading)
                        {
                            <div class="d-flex align-items-center gap-2 p-4">
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                <span style="font-size:13px;">Загрузка шагов...</span>
                            </div>
                        }
                        else if (routeSteps is null || !routeSteps.Any())
                        {
                            <div class="empty-state py-4" style="border:none;">
                                <i class="fa-solid fa-circle-nodes d-block" style="font-size:28px;"></i>
                                <div>Маршрут не содержит шагов</div>
                            </div>
                        }
                        else
                        {

                            @if (metrics is not null)
                            {
                                <div class="mk-steps-summary">
                                    @if (metrics.TotalAvgMin > 0)
                                    {
                                        <span class="mk-summary-chip">
                                            <i class="fa-regular fa-clock" style="color:var(--tn-blue);"></i>
                                            Итого: <strong>@metrics.TotalAvgMin мин.</strong>
                                        </span>
                                    }
                                    @foreach (var (resName, pct) in metrics.ResourceBreakdown.Take(4))
                                    {
                                        <span class="mk-summary-chip">
                                            <i class="fa-solid fa-screwdriver-wrench" style="color:#94a3b8;font-size:11px;"></i>
                                            @resName: <strong>@pct%</strong>
                                        </span>
                                    }
                                    @if (metrics.MaterialCount > 0)
                                    {
                                        <span class="mk-summary-chip">
                                            <i class="fa-solid fa-cubes" style="color:#94a3b8;font-size:11px;"></i>
                                            Материалы: <strong>@metrics.MaterialCount</strong>
                                            @if (metrics.TotalConsumption > 0)
                                            {
                                                <span style="color:var(--tn-text-muted);">&nbsp;(@metrics.TotalConsumption ед.)</span>
                                            }
                                        </span>
                                    }
                                    @if (metrics.Confidence > 0)
                                    {
                                        <span class="mk-summary-chip ms-auto">
                                            <i class="fa-solid fa-percent" style="color:#94a3b8;font-size:11px;"></i>
                                            ЧИ (ср.): <strong>@metrics.Confidence%</strong>
                                        </span>
                                    }
                                </div>
                            }

                            @if (routeMiner is not null && route.SourceEventCount.HasValue && routeMiner.Transitions.Any())
                            {
                                <details style="border-bottom:1px solid var(--tn-border);padding:6px 16px;">
                                    <summary style="font-size:12px;font-weight:600;cursor:pointer;color:var(--tn-text-muted);user-select:none;">
                                        <i class="fa-solid fa-diagram-project me-1"></i>
                                        Переходы между операциями (@routeMiner.Transitions.Count)
                                        @if (routeMiner.RareTransitionCount > 0)
                                        {
                                            <span style="margin-left:6px;background:#fef3c7;color:#d97706;border-radius:4px;padding:1px 6px;font-size:11px;">
                                                @routeMiner.RareTransitionCount редких
                                            </span>
                                        }
                                    </summary>
                                    <div style="max-height:180px;overflow-y:auto;border:1px solid var(--tn-border);border-radius:8px;margin-top:6px;">
                                        <table class="table table-sm mb-0" style="font-size:12px;">
                                            <thead style="position:sticky;top:0;background:#f8fafc;z-index:1;">
                                                <tr>
                                                    <th>Из операции</th><th>В операцию</th>
                                                    <th style="width:55px;">Кол-во</th><th style="width:70px;">Уверен.</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var trans in routeMiner.Transitions)
                                                {
                                                    <tr style="@(trans.IsRare ? "background:#fffbeb;" : "")">
                                                        <td style="color:var(--tn-text-muted);">@trans.From</td>
                                                        <td style="font-weight:500;">@trans.To</td>
                                                        <td>@trans.Count</td>
                                                        <td>
                                                            <span style="color:@(trans.Confidence >= 50 ? "#16a34a" : trans.Confidence >= 10 ? "#d97706" : "#dc2626");font-weight:600;">
                                                                @trans.Confidence%
                                                            </span>
                                                            @if (trans.IsRare)
                                                            {
                                                                <i class="fa-solid fa-triangle-exclamation ms-1" style="color:#d97706;font-size:10px;" title="Редкий переход"></i>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </details>
                            }

                            @if (!isMain && mainRouteSteps.Any())
                            {
                                var fullDiffCnt  = routeSteps.Count(s => GetStepDiff(s) == DiffLevel.FullDiff);
                                var normsDiffCnt = routeSteps.Count(s => GetStepDiff(s) == DiffLevel.NormsDiff);
                                var mainRoute2   = productRoutes.FirstOrDefault(r => r.Status == "published");
                                routeMetricsCache.TryGetValue(mainRoute2?.Id ?? 0, out var mainM);
                                var timeDiff = (metrics is not null && mainM is not null)
                                    ? metrics.TotalAvgMin - mainM.TotalAvgMin
                                    : (decimal?)null;
                                @if (fullDiffCnt > 0 || normsDiffCnt > 0 || timeDiff.HasValue)
                                {
                                    <div class="mk-diff-notice">
                                        <i class="fa-solid fa-circle-exclamation"></i>
                                        Отличия от основного:
                                        @if (fullDiffCnt > 0)
                                        {
                                            <span style="background:#fee2e2;color:#dc2626;border-radius:4px;padding:0 6px;">
                                                @fullDiffCnt шаг(ов) — другая операция
                                            </span>
                                        }
                                        @if (normsDiffCnt > 0)
                                        {
                                            <span style="background:#fef3c7;color:#d97706;border-radius:4px;padding:0 6px;">
                                                @normsDiffCnt шаг(ов) — другие нормы/ресурсы
                                            </span>
                                        }
                                        @if (timeDiff.HasValue && mainM!.TotalAvgMin > 0)
                                        {
                                            var pct  = Math.Round(timeDiff.Value / mainM.TotalAvgMin * 100, 1);
                                            var sign = timeDiff.Value >= 0 ? "+" : "";
                                            <span style="background:#eff6ff;color:#1d4ed8;border-radius:4px;padding:0 6px;">
                                                <i class="fa-regular fa-clock"></i>
                                                Время: @sign@timeDiff.Value.ToString("F1") мин (@sign@pct.ToString("F1")%)
                                            </span>
                                        }
                                    </div>
                                }
                            }

                            <div class="mk-steps-flow">
                                @{ int stepIdx = 0; }
                                @foreach (var step in routeSteps.OrderBy(s => s.SequenceNum).ThenBy(s => s.Id))
                                {
                                    @if (stepIdx > 0)
                                    {
                                        <div class="mk-step-arrow">
                                            <i class="fa-solid fa-arrow-right"></i>
                                        </div>
                                    }
                                    stepIdx++;
                                    var sel     = selectedStep?.Id == step.Id;
                                    var diff    = !isMain ? GetStepDiff(step) : DiffLevel.None;
                                    var diffCss = diff == DiffLevel.FullDiff  ? "diff"
                                                : diff == DiffLevel.NormsDiff ? "norms-diff"
                                                : "";
                                    var sName   = step.Operation?.Name ?? step.Description ?? "—";
                                    var tot     = step.TimeNorms.Sum(tn => tn.NormValue);
                                    <div class="mk-step-card @(sel ? "selected" : "") @diffCss"
                                         @onclick="() => SelectStep(step, route.Id)">
                                        @StepCardInner(step, sName, tot, sel, route.Id, diff)
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        }
    </div>
</div>

@if (showAnalyticsModal)
{
    <div class="tn-backdrop" @onclick="() => showAnalyticsModal = false">
        <div @onclick:stopPropagation style="background:#fff;border-radius:14px;width:min(1500px,96vw);max-height:95vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.18);">

            <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 24px;border-bottom:1px solid var(--tn-border);flex-shrink:0;">
                <div>
                    <h4 style="margin:0;font-size:16px;font-weight:700;">
                        <i class="fa-solid fa-chart-line me-2" style="color:var(--tn-blue);"></i>
                        Аналитика изделия:&nbsp;<span style="color:var(--tn-blue);">@(selectedProduct?.Name ?? "")</span>
                    </h4>
                    @if (analyticsData?.ProductCode is not null)
                    {
                        <div style="font-size:11px;color:var(--tn-text-muted);margin-top:2px;">Код: @analyticsData.ProductCode</div>
                    }
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showAnalyticsModal = false">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div style="overflow-y:auto;padding:20px 24px;display:flex;flex-direction:column;gap:20px;">

                @if (analyticsLoading)
                {
                    <div style="text-align:center;padding:60px;color:var(--tn-text-muted);">
                        <div class="spinner-border text-primary mb-3"></div>
                        <div>Загрузка данных...</div>
                    </div>
                }
                else if (analyticsData is null)
                {
                    <div style="text-align:center;padding:40px;color:var(--tn-text-muted);">
                        <i class="fa-solid fa-circle-exclamation d-block" style="font-size:32px;margin-bottom:12px;"></i>
                        Не удалось загрузить данные по изделию.
                    </div>
                }
                else
                {

                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;">
                        @{
                            var pciColor = AnalyticsPciColor(analyticsData.PciStatus);
                            var pciLabel = AnalyticsPciLabel(analyticsData.PciStatus);
                        }
                        <div style="background:#f8fafc;border-radius:10px;padding:14px 16px;border:1px solid var(--tn-border);">
                            <div style="font-size:11px;color:var(--tn-text-muted);font-weight:500;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Текущий PCI</div>
                            @if (analyticsData.CurrentPci.HasValue)
                            {
                                <div style="font-size:28px;font-weight:700;color:@pciColor;line-height:1;">@analyticsData.CurrentPci.Value.ToString("N1")%</div>
                                <div style="font-size:11px;margin-top:4px;color:@pciColor;font-weight:500;">@pciLabel</div>
                                @if (analyticsData.PciCalculatedAt.HasValue)
                                {
                                    <div style="font-size:10px;color:var(--tn-text-muted);margin-top:2px;">@analyticsData.PciCalculatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                }
                            }
                            else
                            {
                                <div style="font-size:16px;font-weight:600;color:#94a3b8;">Нет данных</div>
                            }
                        </div>

                        <div style="background:#f8fafc;border-radius:10px;padding:14px 16px;border:1px solid var(--tn-border);grid-column:span 2;">
                            <div style="font-size:11px;color:var(--tn-text-muted);font-weight:500;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Основной маршрут</div>
                            <div style="font-size:14px;font-weight:600;">@(analyticsData.PublishedRouteName ?? "—")</div>
                            @if (analyticsData.PublishedRouteVersion.HasValue)
                            {
                                <div style="font-size:11px;color:var(--tn-text-muted);">Версия @analyticsData.PublishedRouteVersion</div>
                            }
                        </div>

                        <div style="background:#f8fafc;border-radius:10px;padding:14px 16px;border:1px solid var(--tn-border);">
                            <div style="font-size:11px;color:var(--tn-text-muted);font-weight:500;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">События / Трассы</div>
                            <div style="font-size:22px;font-weight:700;color:var(--tn-blue);">@analyticsData.EventCount</div>
                            <div style="font-size:11px;color:var(--tn-text-muted);">@analyticsData.TraceCount трасс</div>
                        </div>

                        <div style="background:#f8fafc;border-radius:10px;padding:14px 16px;border:1px solid var(--tn-border);">
                            <div style="font-size:11px;color:var(--tn-text-muted);font-weight:500;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Маршрутные карты</div>
                            <div style="font-size:22px;font-weight:700;">@analyticsData.RouteCount</div>
                            <div style="font-size:11px;color:var(--tn-text-muted);">версий маршрута</div>
                        </div>

                        <div style="background:#f8fafc;border-radius:10px;padding:14px 16px;border:1px solid var(--tn-border);">
                            <div style="font-size:11px;color:var(--tn-text-muted);font-weight:500;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Нормы</div>
                            <div style="font-size:14px;font-weight:600;">⏱ @analyticsData.TimeNormCount времени</div>
                            <div style="font-size:14px;font-weight:600;margin-top:2px;">📦 @analyticsData.MaterialNormCount материалов</div>
                        </div>

                        @if (analyticsData.CurrentPci.HasValue)
                        {
                            <div style="background:#f8fafc;border-radius:10px;padding:14px 16px;border:1px solid var(--tn-border);grid-column:span 2;">
                                <div style="font-size:11px;color:var(--tn-text-muted);font-weight:500;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;">Отклонения</div>
                                <div style="font-size:12px;">⏱ Время: <strong>@analyticsData.TimeDeviationAvg.ToString("N1")%</strong></div>
                                <div style="font-size:12px;">🔀 Маршрут: <strong>@analyticsData.RouteDeviation.ToString("N1")%</strong></div>
                                <div style="font-size:12px;">📦 Матер.: <strong>@analyticsData.MaterialDeviationAvg.ToString("N1")%</strong></div>
                                <div style="font-size:12px;">🔧 Ресурсы: <strong>@analyticsData.ResourceDeviation.ToString("N1")%</strong></div>
                            </div>
                        }
                    </div>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">

                        <div style="background:#f8fafc;border-radius:10px;padding:16px;border:1px solid var(--tn-border);">
                            <div style="font-size:13px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:6px;">
                                <i class="fa-solid fa-chart-line" style="color:var(--tn-blue);"></i>Динамика PCI
                            </div>
                            @if (analyticsData.PciHistory.Count >= 2)
                            {
                                @((MarkupString)BuildPciSvg(analyticsData.PciHistory))
                            }
                            else
                            {
                                <div style="text-align:center;padding:30px;color:var(--tn-text-muted);font-size:13px;">
                                    <i class="fa-solid fa-chart-area d-block" style="font-size:28px;margin-bottom:8px;opacity:.3;"></i>
                                    Недостаточно данных для построения динамики PCI
                                </div>
                            }
                        </div>

                        <div style="background:#f8fafc;border-radius:10px;padding:16px;border:1px solid var(--tn-border);">
                            <div style="font-size:13px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:6px;">
                                <i class="fa-solid fa-ranking-star" style="color:#d97706;"></i>Изделия с наибольшим отклонением от НСИ
                            </div>
                            @if (analyticsData.AllProductsPci.Any())
                            {
                                <div style="display:flex;flex-direction:column;gap:6px;max-height:200px;overflow-y:auto;">
                                    @foreach (var entry in analyticsData.AllProductsPci)
                                    {
                                        var barColor = AnalyticsPciColor(entry.Status);
                                        <div style="display:flex;align-items:center;gap:8px;">
                                            <span style="width:130px;font-size:11px;text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;@(entry.IsCurrent ? "font-weight:700;color:var(--tn-blue);" : "")">@entry.ProductName</span>
                                            <div style="flex:1;background:#e2e8f0;border-radius:3px;height:14px;overflow:hidden;">
                                                <div style="width:@(entry.Pci)%;background:@barColor;height:100%;border-radius:3px;transition:width .3s;"></div>
                                            </div>
                                            <span style="width:38px;font-size:11px;font-weight:600;color:@barColor;">@entry.Pci.ToString("N0")%</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div style="text-align:center;padding:30px;color:var(--tn-text-muted);font-size:13px;">
                                    Нет данных для сравнения изделий по PCI
                                </div>
                            }
                        </div>
                    </div>

                    @if (analyticsData.CurrentPci.HasValue)
                    {
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">

                            <div style="background:#f8fafc;border-radius:10px;padding:16px;border:1px solid var(--tn-border);">
                                <div style="font-size:13px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:6px;">
                                    <i class="fa-solid fa-chart-pie" style="color:#7c3aed;"></i>Причины снижения PCI
                                </div>
                                @{
                                    var deviations = new[]
                                    {
                                        ("Время", analyticsData.TimeDeviationAvg,     "#2563eb"),
                                        ("Маршрут", analyticsData.RouteDeviation,     "#d97706"),
                                        ("Материалы", analyticsData.MaterialDeviationAvg, "#7c3aed"),
                                        ("Ресурсы", analyticsData.ResourceDeviation,   "#dc2626"),
                                    };
                                    var total = deviations.Sum(d => d.Item2);
                                }
                                @if (total > 0)
                                {
                                    <div style="display:flex;flex-direction:column;gap:8px;">
                                        @foreach (var (label, val, col) in deviations.Where(d => d.Item2 > 0))
                                        {
                                            var pct = total > 0 ? Math.Round(val / total * 100, 1) : 0m;
                                            <div style="display:flex;align-items:center;gap:8px;">
                                                <span style="width:80px;font-size:12px;text-align:right;">@label</span>
                                                <div style="flex:1;background:#e2e8f0;border-radius:3px;height:14px;overflow:hidden;">
                                                    <div style="width:@(Math.Min(100,pct))%;background:@col;height:100%;border-radius:3px;"></div>
                                                </div>
                                                <span style="width:40px;font-size:11px;font-weight:600;">@val.ToString("N1")%</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div style="text-align:center;padding:20px;color:#16a34a;font-size:13px;">
                                        <i class="fa-solid fa-circle-check me-1"></i>Отклонения не обнаружены
                                    </div>
                                }
                            </div>

                            <div style="background:#f8fafc;border-radius:10px;padding:16px;border:1px solid var(--tn-border);">
                                <div style="font-size:13px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:6px;">
                                    <i class="fa-regular fa-clock" style="color:#dc2626;"></i>Операции с максимальным отклонением времени
                                </div>
                                @if (analyticsData.TopTimeDeviations.Any())
                                {
                                    <div style="display:flex;flex-direction:column;gap:6px;max-height:200px;overflow-y:auto;">
                                        @{var maxDev = analyticsData.TopTimeDeviations.Max(d => d.DeviationPercent);}
                                        @foreach (var dev in analyticsData.TopTimeDeviations)
                                        {
                                            var barW  = maxDev > 0 ? Math.Min(100m, dev.DeviationPercent / maxDev * 100m) : 0m;
                                            var devCol = SeverityColor(dev.Severity);
                                            <div style="display:flex;align-items:center;gap:8px;">
                                                <span style="width:110px;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@dev.OperationName">@dev.OperationName</span>
                                                <div style="flex:1;background:#e2e8f0;border-radius:3px;height:12px;overflow:hidden;">
                                                    <div style="width:@(barW)%;background:@devCol;height:100%;border-radius:3px;"></div>
                                                </div>
                                                <span style="width:44px;font-size:11px;font-weight:600;color:@devCol;">+@dev.DeviationPercent.ToString("N0")%</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div style="text-align:center;padding:20px;color:#16a34a;font-size:13px;">
                                        <i class="fa-solid fa-circle-check me-1"></i>Существенные отклонения по времени не обнаружены
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (analyticsData.OperationIssues.Any() || analyticsData.TransitionIssues.Any() || analyticsData.MaterialIssues.Any() || analyticsData.ResourceIssues.Any())
                    {
                        <div style="font-size:14px;font-weight:700;color:#dc2626;display:flex;align-items:center;gap:6px;">
                            <i class="fa-solid fa-triangle-exclamation"></i>Проблемные элементы
                        </div>

                        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;">

                            <div style="background:#fff5f5;border-radius:10px;padding:14px;border:1px solid #fecaca;">
                                <div style="font-size:12px;font-weight:700;margin-bottom:10px;color:#dc2626;">Проблемные операции (@analyticsData.OperationIssues.Count)</div>
                                @if (analyticsData.OperationIssues.Any())
                                {
                                    <div style="display:flex;flex-direction:column;gap:6px;max-height:180px;overflow-y:auto;">
                                        <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:4px;font-size:10px;font-weight:600;color:var(--tn-text-muted);padding-bottom:4px;border-bottom:1px solid #fecaca;">
                                            <span>Операция</span><span>Норма</span><span>Факт</span><span>Откл.</span>
                                        </div>
                                        @foreach (var iss in analyticsData.OperationIssues)
                                        {
                                            <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:4px;font-size:11px;align-items:center;">
                                                <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@iss.OperationName">@iss.OperationName</span>
                                                <span>@(iss.NormTime?.ToString("N1") ?? "—") мин</span>
                                                <span>@(iss.ActualTime?.ToString("N1") ?? "—") мин</span>
                                                <span style="font-weight:600;color:@SeverityColor(iss.Severity);">@iss.DeviationPercent.ToString("N0")%</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div style="font-size:12px;color:var(--tn-text-muted);">Проблемные операции не обнаружены</div>
                                }
                            </div>

                            <div style="background:#fffbeb;border-radius:10px;padding:14px;border:1px solid #fde68a;">
                                <div style="font-size:12px;font-weight:700;margin-bottom:10px;color:#d97706;">Проблемные переходы (@analyticsData.TransitionIssues.Count)</div>
                                @if (analyticsData.TransitionIssues.Any())
                                {
                                    <div style="display:flex;flex-direction:column;gap:5px;max-height:180px;overflow-y:auto;">
                                        @foreach (var iss in analyticsData.TransitionIssues)
                                        {
                                            <div style="font-size:11px;display:flex;align-items:baseline;gap:6px;padding:4px 0;border-bottom:1px solid #fde68a;">
                                                <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@iss.Message">
                                                    @iss.FromOperation → @iss.ToOperation
                                                </span>
                                                <span style="font-size:10px;background:@(iss.ExistsInRoute ? "#dcfce7" : "#fee2e2");color:@(iss.ExistsInRoute ? "#16a34a" : "#dc2626");border-radius:4px;padding:1px 5px;flex-shrink:0;">
                                                    @(iss.ExistsInRoute ? "в норм." : "лишний")
                                                </span>
                                                @if (iss.ActualCount > 0)
                                                {
                                                    <span style="font-size:10px;color:var(--tn-text-muted);">×@iss.ActualCount</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div style="font-size:12px;color:var(--tn-text-muted);">Проблемные переходы не обнаружены</div>
                                }
                            </div>

                            <div style="background:#f5f3ff;border-radius:10px;padding:14px;border:1px solid #ddd6fe;">
                                <div style="font-size:12px;font-weight:700;margin-bottom:10px;color:#7c3aed;">Проблемные материалы (@analyticsData.MaterialIssues.Count)</div>
                                @if (analyticsData.MaterialIssues.Any())
                                {
                                    <div style="display:flex;flex-direction:column;gap:5px;max-height:180px;overflow-y:auto;">
                                        <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:4px;font-size:10px;font-weight:600;color:var(--tn-text-muted);padding-bottom:4px;border-bottom:1px solid #ddd6fe;">
                                            <span>Материал</span><span>Норма</span><span>Факт</span><span>Откл.</span>
                                        </div>
                                        @foreach (var iss in analyticsData.MaterialIssues)
                                        {
                                            <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:4px;font-size:11px;align-items:center;">
                                                <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@iss.MaterialName">@iss.MaterialName</span>
                                                <span>@(iss.NormConsumption?.ToString("N2") ?? "—")</span>
                                                <span>@(iss.ActualConsumption?.ToString("N2") ?? "—")</span>
                                                <span style="font-weight:600;color:@SeverityColor(iss.Severity);">@iss.DeviationPercent.ToString("N0")%</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div style="font-size:12px;color:var(--tn-text-muted);">Данные по материалам отсутствуют</div>
                                }
                            </div>

                            <div style="background:#f0f9ff;border-radius:10px;padding:14px;border:1px solid #bae6fd;">
                                <div style="font-size:12px;font-weight:700;margin-bottom:10px;color:#0369a1;">Проблемные ресурсы (@analyticsData.ResourceIssues.Count)</div>
                                @if (analyticsData.ResourceIssues.Any())
                                {
                                    <div style="display:flex;flex-direction:column;gap:5px;max-height:180px;overflow-y:auto;">
                                        @foreach (var iss in analyticsData.ResourceIssues)
                                        {
                                            <div style="font-size:11px;display:flex;align-items:baseline;gap:6px;padding:4px 0;border-bottom:1px solid #bae6fd;">
                                                <span style="flex:1;overflow:hidden;text-overflow:ellipsis;" title="@iss.Message">@iss.OperationName / @iss.ResourceName</span>
                                                <span style="font-size:10px;background:#fee2e2;color:#dc2626;border-radius:4px;padding:1px 5px;flex-shrink:0;">×@iss.UsageCount</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div style="font-size:12px;color:var(--tn-text-muted);">Проблемные ресурсы не обнаружены</div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="background:#f0fdf4;border-radius:10px;padding:16px;border:1px solid #bbf7d0;display:flex;align-items:center;gap:10px;">
                            <i class="fa-solid fa-circle-check" style="color:#16a34a;font-size:20px;"></i>
                            <span style="color:#15803d;font-size:13px;">Проблемных элементов не обнаружено. Фактическое производство соответствует утверждённой НСИ.</span>
                        </div>
                    }

                }
            </div>
        </div>
    </div>
}

@if (showProductInfoModal && infoProduct is not null)
{
    <div class="tn-backdrop" @onclick="() => showProductInfoModal = false">
        <div class="tn-modal" @onclick:stopPropagation style="max-width:360px;">

            <div class="tn-modal-header">
                <h5>@infoProduct.Name</h5>
            </div>

            <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:20px;">
                @if (!string.IsNullOrWhiteSpace(infoProduct.Code))
                {
                    <div>
                        <div style="font-size:11px;color:var(--tn-text-muted);font-weight:500;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:2px;">Код</div>
                        <div style="font-size:14px;font-family:monospace;">@infoProduct.Code</div>
                    </div>
                }
                <div>
                    <div style="font-size:11px;color:var(--tn-text-muted);font-weight:500;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:2px;">Тип</div>
                    <div style="font-size:14px;">@ProductTypeLabel(infoProduct.Type)</div>
                </div>
                <div>
                    <div style="font-size:11px;color:var(--tn-text-muted);font-weight:500;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:2px;">Маршрутов</div>
                    <div style="font-size:14px;">@infoProduct.TechRoutes.Count</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(infoProduct.Description))
                {
                    <div>
                        <div style="font-size:11px;color:var(--tn-text-muted);font-weight:500;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:2px;">Описание</div>
                        <div style="font-size:14px;">@infoProduct.Description</div>
                    </div>
                }
                @{
                    var infoMainRoute = infoProduct.TechRoutes
                        .FirstOrDefault(r => r.Status == "published");
                }
                @if (infoMainRoute is not null)
                {
                    <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:10px;
                                padding:10px 14px;display:flex;align-items:center;gap:10px;">
                        <input type="checkbox" style="width:15px;height:15px;cursor:pointer;flex-shrink:0;"
                               checked="@infoMainRoute.IsAutoUpdate"
                               @onchange="async e => await ToggleAutoUpdate(infoMainRoute, (bool)(e.Value ?? false))" />
                        <div>
                            <div style="font-size:13px;font-weight:500;color:#0369a1;">Автообновление маршрута</div>
                            <div style="font-size:11px;color:#64748b;">Перестраивать при добавлении событий</div>
                        </div>
                    </div>
                }
            </div>

            <div class="tn-modal-footer">
                <button class="btn btn-outline-danger" @onclick="() => DeleteProduct(infoProduct)">
                    <i class="fa-solid fa-trash-can me-1"></i>Удалить
                </button>
                <button class="btn btn-secondary" @onclick="() => showProductInfoModal = false">Отмена</button>
                <AuthorizeView Roles="technologist">
                    <Authorized>
                        <button class="btn btn-primary" @onclick="ShowEditFromInfo">
                            <i class="fa-solid fa-pen me-1"></i>Редактировать
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
}

@if (showRenameRouteModal && renamingRoute is not null)
{
    <div class="tn-backdrop" @onclick="() => showRenameRouteModal = false">
        <div class="tn-modal" @onclick:stopPropagation style="max-width:420px;">
            <div class="tn-modal-header">
                <h5><i class="fa-solid fa-pen-to-square me-2" style="color:var(--tn-blue);"></i>Переименовать маршрут</h5>
            </div>
            <div class="mb-1">
                <label class="form-label">Новое название</label>
                <input class="form-control" @bind="renameValue" @bind:event="oninput" @bind:after="CheckRenameName" />
            </div>
            @if (renameConflict)
            {
                <div class="text-warning small mb-3">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Маршрут с таким именем уже существует
                </div>
            }
            else { <div class="mb-3"></div> }
            <div class="tn-modal-footer">
                <button class="btn btn-secondary" @onclick="() => showRenameRouteModal = false">Отмена</button>
                <button class="btn btn-primary" @onclick="SaveRenameRoute">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Сохранить
                </button>
            </div>
        </div>
    </div>
}

@if (nsiConfirm is not null)
{
    <div class="tn-backdrop" @onclick="() => nsiConfirm = null">
        <div class="tn-modal" @onclick:stopPropagation style="max-width:360px;text-align:center;padding:32px 28px;">
            <div style="font-size:44px;margin-bottom:16px;color:#dc2626;">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div style="font-size:16px;font-weight:600;margin-bottom:8px;">@nsiConfirm.Title</div>
            <div style="font-size:13px;color:var(--tn-text-muted);margin-bottom:24px;">Это действие нельзя отменить.</div>
            <div class="d-flex gap-2 justify-content-center">
                <button class="btn btn-outline-secondary" @onclick="() => nsiConfirm = null">Отмена</button>
                <button class="btn btn-danger" @onclick="RunNsiConfirm">
                    <i class="fa-solid fa-trash-can me-1"></i>Удалить
                </button>
            </div>
        </div>
    </div>
}

@if (showAddStepModal)
{
    <div class="tn-backdrop" @onclick="CloseModals">
        <div class="tn-modal" @onclick:stopPropagation style="max-width:560px;max-height:90vh;overflow-y:auto;">
            <div class="tn-modal-header">
                <h5>Добавить шаг маршрута</h5>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-3">
                    <label class="form-label">№ шага</label>
                    <input type="number" class="form-control" @bind="stepForm.SequenceNum" min="1" />
                </div>
                <div class="col-9">
                    <label class="form-label">Операция</label>
                    <select class="form-select" @bind="stepForm.OperationId">
                        <option value="">— не выбрано —</option>
                        @foreach (var op in allOperations)
                        {
                            <option value="@op.Id">@op.Name</option>
                        }
                    </select>
                </div>
            </div>
