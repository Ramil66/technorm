        var route = new TechRoute
        {
            ProductId = routeForProduct.Id,
            Name      = newRouteName.Trim(),
            Status    = "draft",
            Version   = 1,
            CreatedBy = currentUserId,
        };
        route = await RouteSvc.CreateAsync(route);
        await AuditSvc.LogAsync(currentUserId, "Маршрут создан вручную",
            "TechRoute", route.Id, newValue: new { route.Name, Product = routeForProduct.Name });
        allProducts   = await ProductSvc.GetAllWithRoutesAsync();
        productRoutes = await RouteSvc.GetByProductAsync(routeProductId);
