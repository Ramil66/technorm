        showProductModal = true;
    }

    private async Task SaveProduct()
    {
        if (editingProduct?.Id > 0)
        {
            editingProduct.Code        = productForm.Code;
            editingProduct.Name        = productForm.Name;
            editingProduct.Type        = productForm.Type;
            editingProduct.Description = productForm.Description;
            await ProductSvc.UpdateAsync(editingProduct);
        }
        else
        {
            var p = new Product { Code = productForm.Code, Name = productForm.Name, Type = productForm.Type, Description = productForm.Description };
            p = await ProductSvc.CreateAsync(p);
            allProducts.Add(p);
        }
        FilterProducts();
        CloseModals();
    }

    private void ShowCreateRouteModal(Product p)
    {
        routeForProduct = p;
        newRouteName    = $"МК — {p.Name}";
        showCreateRouteModal = true;
    }

    private async Task CreateRoute()
    {
        if (routeForProduct is null || string.IsNullOrWhiteSpace(newRouteName)) return;
        var route = new TechRoute
        {
            ProductId = routeForProduct.Id,
            Name      = newRouteName.Trim(),
            Status    = "draft",
            Version   = 1,
            CreatedBy = currentUserId,
        };
        route = await RouteSvc.CreateAsync(route);
        if (routeProductId == routeForProduct.Id)
            productRoutes = await RouteSvc.GetByProductAsync(routeProductId);
        CloseModals();
    }

