    private async Task ExportPublishedNsi()
    {
        isExporting = true;
        StateHasChanged();
        try
        {
            var entries = new List<object>();

            foreach (var product in allProducts)
            {
                var routes = product.Id == routeProductId
                    ? productRoutes
                    : await RouteSvc.GetByProductAsync(product.Id);

                var published = routes.FirstOrDefault(r => r.Status == "published");
                if (published is null) continue;

                routeStepsCache.TryGetValue(published.Id, out var cachedSteps);
                List<RouteStep> steps;
                if (cachedSteps is not null)
                {
                    steps = cachedSteps;
                }
                else
                {
                    var full = await RouteSvc.GetByIdWithStepsAsync(published.Id);
                    steps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
                }

                entries.Add(new
                {
                    product = new
                    {
                        id   = product.Id,
                        code = product.Code,
                        name = product.Name,
                        type = ProductTypeLabel(product.Type),
                    },
                    route = new
                    {
                        id        = published.Id,
                        name      = published.Name,
                        version   = published.Version,
                        status    = StatusLabel(published.Status),
                        createdAt = published.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ"),
                        updatedAt = published.UpdatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ"),
                    },
                    steps = steps.OrderBy(s => s.SequenceNum).Select(s => new
                    {
                        sequenceNum = s.SequenceNum,
                        operation   = s.Operation is not null
                            ? (object)new { name = s.Operation.Name, code = s.Operation.Code }
                            : null,
                        description = s.Description,
                        timeNorms = s.TimeNorms.OrderByDescending(t => t.NormValue).Select(t => new
                        {
                            resource  = t.Resource?.Name ?? "Общая",
                            normValue = t.NormValue,
                            unit      = "мин",
                        }).ToList(),
                        materialNorms = s.MaterialNorms.OrderByDescending(m => m.ConsumptionRate).Select(m => new
                        {
                            material        = m.Material?.Name ?? "—",
                            unit            = m.Material?.Unit ?? "ед.",
                            consumptionRate = m.ConsumptionRate,
                        }).ToList(),
                    }).ToList(),
                });
            }

            var exportObj = new
            {
                exportedAt   = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"),
                totalRoutes  = entries.Count,
                routeCards   = entries,
            };

            var json = JsonSerializer.Serialize(exportObj, new JsonSerializerOptions { WriteIndented = true });
            var filename = $"nsi_export_{DateTime.UtcNow:yyyyMMdd_HHmm}.json";

            await AuditSvc.LogAsync(currentUserId, "Экспорт всех опубликованных НСИ в JSON",
                "System", 0,
                newValue: new { TotalRoutes = entries.Count, ExportedAt = DateTime.UtcNow });

            await JS.InvokeVoidAsync("tnInterop.downloadJson", filename, json);
        }
        finally
        {
            isExporting = false;
        }
    }

