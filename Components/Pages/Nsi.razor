    private async Task LoadProductRoutes()
    {
        expandedRouteIds.Clear();
        loadingRouteIds.Clear();
        routeStepsCache.Clear();
        routeMetricsCache.Clear();
        mainRouteSteps  = [];
        selectedStep    = null;
        currentRoute    = null;
        minerError      = null;

        if (routeProductId == 0) { productRoutes = []; return; }
        productRoutes = await RouteSvc.GetByProductAsync(routeProductId);

        var mainRoute = productRoutes.FirstOrDefault(r => r.Status == "published");
        if (mainRoute is not null)
        {
            var full = await RouteSvc.GetByIdWithStepsAsync(mainRoute.Id);
            mainRouteSteps                    = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
            routeStepsCache[mainRoute.Id]     = mainRouteSteps;
            routeMetricsCache[mainRoute.Id]   = ComputeMetrics(mainRouteSteps);

            // Запускаем пересчёт PCI в фоне при каждом переходе на изделие
            _ = RecalculatePciInBackgroundAsync(routeProductId);
        }
    }

    private async Task RecalculatePciInBackgroundAsync(int productId)
    {
        isPciCalculating = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await ConformanceSvc.TriggerRecalculationAsync(productId);
            productRoutes = await RouteSvc.GetByProductAsync(productId);
        }
        catch { /* не прерываем UI при ошибке PCI */ }
        finally
        {
            isPciCalculating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleRoute(TechRoute route)
    {
        if (expandedRouteIds.Contains(route.Id))
        {
            expandedRouteIds.Remove(route.Id);
            return;
        }
        expandedRouteIds.Add(route.Id);

        if (!routeStepsCache.ContainsKey(route.Id))
        {
            loadingRouteIds.Add(route.Id);
            StateHasChanged();
            var full  = await RouteSvc.GetByIdWithStepsAsync(route.Id);
            var steps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
            routeStepsCache[route.Id]   = steps;
            routeMetricsCache[route.Id] = ComputeMetrics(steps);
            loadingRouteIds.Remove(route.Id);
        }
    }

    private async Task SetDefaultRoute(TechRoute route)
    {
        await RouteSvc.PublishAsync(route.Id, currentUserId);
        await AuditSvc.LogAsync(currentUserId, "Маршрут опубликован как основной",
            "TechRoute", route.Id, newValue: new { route.Name, route.ProductId });
        productRoutes = await RouteSvc.GetByProductAsync(routeProductId);

        routeStepsCache.TryGetValue(route.Id, out var cached);
        mainRouteSteps = cached ?? [];
        if (!mainRouteSteps.Any())
        {
            var full = await RouteSvc.GetByIdWithStepsAsync(route.Id);
            mainRouteSteps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
            routeStepsCache[route.Id] = mainRouteSteps;
        }
    }

    private void DeleteRoute(TechRoute route)
    {
        nsiConfirm = new("Удалить маршрут?", async () =>
        {
            bool wasMain = route.Status == "published";
            await AuditSvc.LogAsync(currentUserId, "Маршрут удалён",
                "TechRoute", route.Id, oldValue: new { route.Name, route.ProductId, route.Status });
            await RouteSvc.DeleteAsync(route.Id);
            expandedRouteIds.Remove(route.Id);
            routeStepsCache.Remove(route.Id);
            routeMetricsCache.Remove(route.Id);
            if (selectedStepRouteId == route.Id) selectedStep = null;

            productRoutes = await RouteSvc.GetByProductAsync(routeProductId);

            if (wasMain)
            {
                mainRouteSteps = [];
                if (productRoutes.Any())
                {
                    await RouteSvc.PublishAsync(productRoutes[0].Id, currentUserId);
                    productRoutes = await RouteSvc.GetByProductAsync(routeProductId);
                    var newMain = productRoutes.FirstOrDefault(r => r.Status == "published");
                    if (newMain is not null)
                    {
                        var full = await RouteSvc.GetByIdWithStepsAsync(newMain.Id);
                        mainRouteSteps = full?.Steps.OrderBy(s => s.SequenceNum).ToList() ?? [];
                        routeStepsCache[newMain.Id] = mainRouteSteps;
                    }
                }
            }

            allProducts = await ProductSvc.GetAllWithRoutesAsync();
        });
    }

    private async Task DuplicateRoute(TechRoute route)
    {
        int n = 1;
        while (productRoutes.Any(r => r.Name == $"{route.Name} Копия {n}")) n++;
        var newName = $"{route.Name} Копия {n}";
        var newRoute = await RouteSvc.DuplicateAsync(route.Id, newName, currentUserId);
        await AuditSvc.LogAsync(currentUserId, "Маршрут дублирован",
            "TechRoute", newRoute.Id, newValue: new { Name = newName, Source = route.Name, route.ProductId });
        allProducts   = await ProductSvc.GetAllWithRoutesAsync();
        productRoutes = await RouteSvc.GetByProductAsync(routeProductId);
    }

