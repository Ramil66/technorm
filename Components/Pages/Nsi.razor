@page "/nsi"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ITechRouteService RouteSvc
@inject IRouteStepService StepSvc
@inject IProductService ProductSvc
@inject ITimeNormService TimeNormSvc
@inject IMaterialNormService MatNormSvc
@inject IResourceService ResourceSvc
@inject IMaterialService MatSvc
@inject IOperationService OpSvc
@inject IRouteBuilderService RouteBuildSvc
@inject IAuditLogService AuditSvc

<PageTitle>НСИ — ТехНорм</PageTitle>

<div class="page-header">
    <h1><i class="fa-solid fa-route" style="color:var(--tn-blue);margin-right:10px;font-size:18px;"></i>Маршрутные карты</h1>
</div>

<div class="mk-canvas">

    <!-- ══════════ Две отдельные панели управления ══════════ -->
    <div style="display:flex;gap:16px;flex-wrap:wrap;flex-shrink:0;align-items:flex-start;width:100%;">

        <!-- Панель 1: выбор изделия -->
        <div class="mk-topbar" style="flex:none;width:fit-content;">
            <div class="d-flex align-items-center gap-2 flex-wrap">

                <!-- Кастомный dropdown -->
                <div style="position:relative;">
                    <button class="product-picker-toggle" @onclick="ToggleProductDropdown">
                        <i class="fa-solid fa-box" style="font-size:11px;color:var(--tn-blue);"></i>
                        <span style="max-width:220px;overflow:hidden;text-overflow:ellipsis;">@SelectedProductName</span>
                        <i class="fa-solid fa-chevron-down" style="font-size:9px;color:var(--tn-text-muted);"></i>
                    </button>

                    @if (showProductDropdown)
                    {
                        <div style="position:fixed;inset:0;z-index:999;" @onclick="CloseProductDropdown"></div>
                        <div class="product-picker-menu">
                            @foreach (var p in allProducts)
                            {
                                <div class="product-picker-item @(routeProductId == p.Id ? "selected" : "")">
                                    <span class="product-picker-name" @onclick="() => SelectProduct(p)">
                                        @p.Name
                                        @if (p.TechRoutes.Count > 0)
                                        {
                                            <small style="color:var(--tn-text-muted);font-weight:400;margin-left:4px;">
                                                (@p.TechRoutes.Count)
                                            </small>
                                        }
                                    </span>
                                    <div class="product-picker-actions">
                                        <button title="Информация об изделии"
                                                @onclick:stopPropagation @onclick="() => ShowProductInfo(p)">
                                            <i class="fa-solid fa-circle-question"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- разделитель -->
                <div style="width:1px;height:26px;background:var(--tn-border);flex-shrink:0;"></div>

                <!-- + новое изделие -->
                <AuthorizeView Roles="technologist">
                    <Authorized>
                        <button class="btn btn-sm btn-outline-primary" title="Добавить изделие"
                                @onclick="ShowAddProductModal">
                            <i class="fa-solid fa-plus me-1"></i>Новое изделие
                        </button>
                    </Authorized>
                </AuthorizeView>

                @if (routeProductId > 0 && productRoutes.Any())
                {
                    <span style="font-size:12px;color:var(--tn-text-muted);">
                        <strong>@productRoutes.Count</strong> МК
                    </span>
                }
            </div>
        </div>

        <!-- Панель 2: создание маршрутов (только при выбранном изделии) -->
        @if (routeProductId > 0)
        {
            <div class="mk-topbar" style="flex-shrink:0;align-self:flex-start;margin-left:auto;">
                <div class="d-flex gap-2 align-items-center">
                    <AuthorizeView Roles="technologist">
                        <Authorized>
                            <button class="btn btn-primary btn-sm" @onclick="AutoBuildRoute" disabled="@isMining">
                                @if (isMining)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i>
                                }
                                Построить из событий
                            </button>
                            <button class="btn btn-outline-primary btn-sm" @onclick="ShowCreateRouteModalFromTab0">
                                <i class="fa-solid fa-plus me-1"></i>Создать вручную
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        }
    </div>

    @if (minerError is not null)
    {
        <div class="alert alert-danger py-2 mb-0" style="font-size:12px;flex-shrink:0;">
            <i class="fa-solid fa-circle-exclamation me-1"></i>@minerError
        </div>
    }

    <!-- ══════════ Область маршрутов ══════════ -->
    <div class="mk-routes-area">
        @if (routeProductId == 0)
        {
            <div class="empty-state" style="border:none;padding-top:80px;">
                <i class="fa-solid fa-diagram-project d-block" style="opacity:.2;"></i>
                <div>Выберите изделие для просмотра маршрутных карт</div>
            </div>
        }
        else if (!productRoutes.Any())
        {
            <div class="empty-state" style="border:none;padding-top:80px;">
                <i class="fa-solid fa-route d-block" style="opacity:.2;"></i>
                <div>Маршрутных карт нет</div>
                <div style="font-size:12px;color:var(--tn-text-muted);margin-top:8px;">
                    Загрузите события и нажмите «Построить из событий»
                </div>
            </div>
        }
        else
        {
            @foreach (var route in productRoutes
                .OrderByDescending(r => r.Status == "published")
                .ThenByDescending(r => r.Version))
            {
                bool isExpanded = expandedRouteIds.Contains(route.Id);
                bool isMain     = route.Status == "published";
                bool isLoading  = loadingRouteIds.Contains(route.Id);
                routeStepsCache.TryGetValue(route.Id, out var routeSteps);
                routeMetricsCache.TryGetValue(route.Id, out var metrics);

                <div class="mk-route-block @(isMain ? "mk-route-block-main" : "")">

                    <!-- Заголовок маршрута (двухрядный) -->
                    <div class="mk-route-header" @onclick="() => ToggleRoute(route)">

                        <!-- Ряд 1: основная информация -->
                        <div class="mk-route-row-main">
                            <div class="route-radio @(isMain ? "active" : "")" style="flex-shrink:0;"></div>
                            <span class="mk-route-num" title="@route.Name">@TruncText(route.Name, 36)</span>

                            @if (isMain)
                            {
                                <span class="mk-badge mk-badge-main">
                                    <i class="fa-solid fa-star me-1" style="font-size:9px;"></i>Основной
                                </span>
                            }
                            else
                            {
                                <span class="mk-badge mk-badge-alt">@StatusLabel(route.Status)</span>
                            }

                            @if (metrics is not null)
                            {
                                @if (metrics.TotalAvgMin > 0)
                                {
                                    <span class="mk-metric"><i class="fa-regular fa-clock"></i>@metrics.TotalAvgMin мин.</span>
                                }
                                <span class="mk-metric"><i class="fa-solid fa-list-ol"></i>@metrics.StepCount оп.</span>
                                @if (metrics.ResourceCount > 0)
                                {
                                    <span class="mk-metric"><i class="fa-solid fa-screwdriver-wrench"></i>@metrics.ResourceCount рес.</span>
                                }
                                @if (metrics.Confidence > 0)
                                {
                                    <span class="mk-metric"><i class="fa-solid fa-percent"></i>ЧИ @metrics.Confidence%</span>
                                }
                            }

                            <!-- Кнопки управления -->
                            <div class="ms-auto d-flex gap-1 align-items-center" @onclick:stopPropagation>
                                @if (!isMain)
                                {
                                    <AuthorizeView Roles="technologist">
                                        <Authorized>
                                            <button class="btn btn-sm btn-outline-primary py-0 px-2"
                                                    title="Сделать основным" @onclick="() => SetDefaultRoute(route)">
                                                <i class="fa-solid fa-star"></i>
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                }
                                <AuthorizeView Roles="technologist">
                                    <Authorized>
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                title="Переименовать" @onclick="() => PrepareRenameRoute(route)">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary py-0 px-2"
                                                title="Добавить шаг" @onclick="() => PrepareAddStep(route)">
                                            <i class="fa-solid fa-plus"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                title="Дублировать" @onclick="() => DuplicateRoute(route)">
                                            <i class="fa-solid fa-copy"></i>
                                        </button>
                                        @if (route.SourceEventCount.HasValue)
                                        {
                                            <button class="btn btn-sm btn-outline-success py-0 px-2"
                                                    title="Перестроить маршрут из событий"
                                                    @onclick="() => RebuildRoute(route)"
                                                    disabled="@rebuildingRouteIds.Contains(route.Id)">
                                                @if (rebuildingRouteIds.Contains(route.Id))
                                                {
                                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                                }
                                                else
                                                {
                                                    <i class="fa-solid fa-rotate"></i>
                                                }
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-outline-danger py-0 px-2"
                                                title="Удалить маршрут" @onclick="() => DeleteRoute(route)">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                            <i class="fa-solid @(isExpanded ? "fa-chevron-up" : "fa-chevron-down")"
                               style="color:var(--tn-text-muted);flex-shrink:0;"></i>
                        </div>

                        <!-- Ряд 2: метаданные -->
                        <div class="mk-route-row-meta">
                            <span class="mk-route-meta-item">
                                <i class="fa-solid fa-code-branch" style="font-size:10px;"></i>
                                v@route.Version
                            </span>
                            <span class="mk-route-meta-item">
                                <i class="fa-regular fa-calendar" style="font-size:10px;"></i>
                                Создан: @route.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </span>
                            <span class="mk-route-meta-item">
                                <i class="fa-solid fa-pen-to-square" style="font-size:10px;"></i>
                                Обновлён: @route.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </span>
                            <span class="mk-route-meta-item">
                                <i class="fa-solid fa-database" style="font-size:10px;"></i>
                                Источник: @(route.SourceEventCount.HasValue ? $"{route.SourceEventCount} событий" : "ручной ввод")
                            </span>
                        </div>
                    </div>

                    <!-- Развёрнутое содержимое -->
                    @if (isExpanded)
                    {
                        @if (isLoading)
                        {
                            <div class="d-flex align-items-center gap-2 p-4">
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                <span style="font-size:13px;">Загрузка шагов...</span>
                            </div>
                        }
                        else if (routeSteps is null || !routeSteps.Any())
                        {
                            <div class="empty-state py-4" style="border:none;">
                                <i class="fa-solid fa-circle-nodes d-block" style="font-size:28px;"></i>
                                <div>Маршрут не содержит шагов</div>
                            </div>
                        }
                        else
                        {
                            <!-- Сводная строка -->
                            @if (metrics is not null)
                            {
                                <div class="mk-steps-summary">
                                    @if (metrics.TotalAvgMin > 0)
                                    {
                                        <span class="mk-summary-chip">
                                            <i class="fa-regular fa-clock" style="color:var(--tn-blue);"></i>
                                            Итого: <strong>@metrics.TotalAvgMin мин.</strong>
                                        </span>
                                    }
                                    @foreach (var (resName, pct) in metrics.ResourceBreakdown.Take(4))
                                    {
                                        <span class="mk-summary-chip">
                                            <i class="fa-solid fa-screwdriver-wrench" style="color:#94a3b8;font-size:11px;"></i>
                                            @resName: <strong>@pct%</strong>
                                        </span>
                                    }
                                    @if (metrics.Confidence > 0)
                                    {
                                        <span class="mk-summary-chip ms-auto">
                                            <i class="fa-solid fa-percent" style="color:#94a3b8;font-size:11px;"></i>
                                            ЧИ (ср.): <strong>@metrics.Confidence%</strong>
                                        </span>
                                    }
                                </div>
                            }

                            <!-- Уведомление об отличиях от основного -->
                            @if (!isMain && mainRouteSteps.Any())
                            {
                                var fullDiffCnt  = routeSteps.Count(s => GetStepDiff(s) == DiffLevel.FullDiff);
                                var normsDiffCnt = routeSteps.Count(s => GetStepDiff(s) == DiffLevel.NormsDiff);
                                var mainRoute2   = productRoutes.FirstOrDefault(r => r.Status == "published");
                                routeMetricsCache.TryGetValue(mainRoute2?.Id ?? 0, out var mainM);
                                var timeDiff = (metrics is not null && mainM is not null)
                                    ? metrics.TotalAvgMin - mainM.TotalAvgMin
                                    : (decimal?)null;
                                @if (fullDiffCnt > 0 || normsDiffCnt > 0 || timeDiff.HasValue)
                                {
                                    <div class="mk-diff-notice">
                                        <i class="fa-solid fa-circle-exclamation"></i>
                                        Отличия от основного:
                                        @if (fullDiffCnt > 0)
                                        {
                                            <span style="background:#fee2e2;color:#dc2626;border-radius:4px;padding:0 6px;">
                                                @fullDiffCnt шаг(ов) — другая операция
                                            </span>
                                        }
                                        @if (normsDiffCnt > 0)
                                        {
                                            <span style="background:#fef3c7;color:#d97706;border-radius:4px;padding:0 6px;">
                                                @normsDiffCnt шаг(ов) — другие нормы/ресурсы
                                            </span>
                                        }
                                        @if (timeDiff.HasValue && mainM!.TotalAvgMin > 0)
                                        {
                                            var pct  = Math.Round(timeDiff.Value / mainM.TotalAvgMin * 100, 1);
                                            var sign = timeDiff.Value >= 0 ? "+" : "";
                                            <span style="background:#eff6ff;color:#1d4ed8;border-radius:4px;padding:0 6px;">
                                                <i class="fa-regular fa-clock"></i>
                                                Время: @sign@timeDiff.Value.ToString("F1") мин (@sign@pct.ToString("F1")%)
                                            </span>
                                        }
                                    </div>
                                }
                            }

                            <!-- Горизонтальный поток шагов (всегда последовательно) -->
                            <div class="mk-steps-flow">
                                @{ int stepIdx = 0; }
                                @foreach (var step in routeSteps.OrderBy(s => s.SequenceNum).ThenBy(s => s.Id))
                                {
                                    @if (stepIdx > 0)
                                    {
                                        <div class="mk-step-arrow">
                                            <i class="fa-solid fa-arrow-right"></i>
                                        </div>
                                    }
                                    stepIdx++;
                                    var sel     = selectedStep?.Id == step.Id;
                                    var diff    = !isMain ? GetStepDiff(step) : DiffLevel.None;
                                    var diffCss = diff == DiffLevel.FullDiff  ? "diff"
                                                : diff == DiffLevel.NormsDiff ? "norms-diff"
                                                : "";
                                    var sName   = step.Operation?.Name ?? step.Description ?? "—";
                                    var tot     = step.TimeNorms.Sum(tn => tn.NormValue);
                                    <div class="mk-step-card @(sel ? "selected" : "") @diffCss"
                                         @onclick="() => SelectStep(step, route.Id)">
                                        @StepCardInner(step, sName, tot, sel, route.Id, diff)
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        }
    </div>
</div>

<!-- ═══════════════ Информация об изделии ═══════════════ -->
@if (showProductInfoModal && infoProduct is not null)
{
    <div class="tn-backdrop" @onclick="() => showProductInfoModal = false">
        <div class="tn-modal" @onclick:stopPropagation style="max-width:360px;">

            <div class="tn-modal-header">
                <h5>@infoProduct.Name</h5>
            </div>

            <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:20px;">
                @if (!string.IsNullOrWhiteSpace(infoProduct.Code))
                {
                    <div>
                        <div style="font-size:11px;color:var(--tn-text-muted);font-weight:500;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:2px;">Код</div>
                        <div style="font-size:14px;font-family:monospace;">@infoProduct.Code</div>
                    </div>
                }
                <div>
                    <div style="font-size:11px;color:var(--tn-text-muted);font-weight:500;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:2px;">Тип</div>
                    <div style="font-size:14px;">@ProductTypeLabel(infoProduct.Type)</div>
                </div>
                <div>
                    <div style="font-size:11px;color:var(--tn-text-muted);font-weight:500;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:2px;">Маршрутов</div>
                    <div style="font-size:14px;">@infoProduct.TechRoutes.Count</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(infoProduct.Description))
                {
                    <div>
                        <div style="font-size:11px;color:var(--tn-text-muted);font-weight:500;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:2px;">Описание</div>
                        <div style="font-size:14px;">@infoProduct.Description</div>
                    </div>
                }
                @{
                    var infoMainRoute = infoProduct.TechRoutes
                        .FirstOrDefault(r => r.Status == "published" && r.SourceEventCount.HasValue);
                }
                @if (infoMainRoute is not null)
                {
                    <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:10px;
                                padding:10px 14px;display:flex;align-items:center;gap:10px;">
                        <input type="checkbox" style="width:15px;height:15px;cursor:pointer;flex-shrink:0;"
                               checked="@infoMainRoute.IsAutoUpdate"
                               @onchange="async e => await ToggleAutoUpdate(infoMainRoute, (bool)(e.Value ?? false))" />
                        <div>
                            <div style="font-size:13px;font-weight:500;color:#0369a1;">Автообновление маршрута</div>
                            <div style="font-size:11px;color:#64748b;">Перестраивать при добавлении событий</div>
                        </div>
                    </div>
                }
            </div>

            <div class="tn-modal-footer">
                <button class="btn btn-outline-danger" @onclick="() => DeleteProduct(infoProduct)">
                    <i class="fa-solid fa-trash-can me-1"></i>Удалить
                </button>
                <button class="btn btn-secondary" @onclick="() => showProductInfoModal = false">Отмена</button>
                <AuthorizeView Roles="technologist">
                    <Authorized>
                        <button class="btn btn-primary" @onclick="ShowEditFromInfo">
                            <i class="fa-solid fa-pen me-1"></i>Редактировать
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
}

<!-- ═══════════════ Переименовать маршрут ═══════════════ -->
@if (showRenameRouteModal && renamingRoute is not null)
{
    <div class="tn-backdrop" @onclick="() => showRenameRouteModal = false">
        <div class="tn-modal" @onclick:stopPropagation style="max-width:420px;">
            <div class="tn-modal-header">
                <h5><i class="fa-solid fa-pen-to-square me-2" style="color:var(--tn-blue);"></i>Переименовать маршрут</h5>
            </div>
            <div class="mb-1">
                <label class="form-label">Новое название</label>
                <input class="form-control" @bind="renameValue" @bind:event="oninput" @bind:after="CheckRenameName" />
            </div>
            @if (renameConflict)
            {
                <div class="text-warning small mb-3">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Маршрут с таким именем уже существует
                </div>
            }
            else { <div class="mb-3"></div> }
            <div class="tn-modal-footer">
                <button class="btn btn-secondary" @onclick="() => showRenameRouteModal = false">Отмена</button>
                <button class="btn btn-primary" @onclick="SaveRenameRoute">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Сохранить
                </button>
            </div>
        </div>
    </div>
}

<!-- ═══════════════ Подтверждение удаления ═══════════════ -->
@if (nsiConfirm is not null)
{
    <div class="tn-backdrop" @onclick="() => nsiConfirm = null">
        <div class="tn-modal" @onclick:stopPropagation style="max-width:360px;text-align:center;padding:32px 28px;">
            <div style="font-size:44px;margin-bottom:16px;color:#dc2626;">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div style="font-size:16px;font-weight:600;margin-bottom:8px;">@nsiConfirm.Title</div>
            <div style="font-size:13px;color:var(--tn-text-muted);margin-bottom:24px;">Это действие нельзя отменить.</div>
            <div class="d-flex gap-2 justify-content-center">
                <button class="btn btn-outline-secondary" @onclick="() => nsiConfirm = null">Отмена</button>
                <button class="btn btn-danger" @onclick="RunNsiConfirm">
                    <i class="fa-solid fa-trash-can me-1"></i>Удалить
                </button>
            </div>
        </div>
    </div>
}

<!-- ═══════════════ Добавить шаг ═══════════════ -->
@if (showAddStepModal)
{
    <div class="tn-backdrop" @onclick="CloseModals">
        <div class="tn-modal" @onclick:stopPropagation style="max-width:560px;max-height:90vh;overflow-y:auto;">
            <div class="tn-modal-header">
                <h5>Добавить шаг маршрута</h5>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-3">
                    <label class="form-label">№ шага</label>
                    <input type="number" class="form-control" @bind="stepForm.SequenceNum" min="1" />
                </div>
                <div class="col-9">
                    <label class="form-label">Операция</label>
                    <select class="form-select" @bind="stepForm.OperationId">
                        <option value="">— не выбрано —</option>
                        @foreach (var op in allOperations)
                        {
                            <option value="@op.Id">@op.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Описание <span style="color:var(--tn-text-muted);font-weight:400;">(если операция не выбрана)</span></label>
                <input class="form-control" @bind="stepForm.Description" placeholder="Название операции" />
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label mb-0" style="font-weight:600;">
                        <i class="fa-regular fa-clock me-1" style="color:var(--tn-blue);"></i>Нормы времени
                    </label>
                    <button class="btn btn-sm btn-outline-primary py-0 px-2" @onclick="AddTimeNormEntry">
                        <i class="fa-solid fa-plus me-1"></i>Добавить
                    </button>
                </div>
                @if (!stepForm.TimeNorms.Any())
                {
                    <div style="font-size:12px;color:var(--tn-text-muted);font-style:italic;">Нормы времени не заданы</div>
                }
                @foreach (var tn in stepForm.TimeNorms)
                {
