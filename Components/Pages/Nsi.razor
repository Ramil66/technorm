    private static string BuildPciSvg(List<PciHistoryPoint> history)
    {
        if (history.Count < 2) return "";

        var rawValues = history.Select(p => (double)p.Pci).ToList();
        double maxRaw = rawValues.Max();
        var vals = maxRaw <= 1.5
            ? rawValues.Select(v => Math.Round(v * 100.0, 1)).ToList()
            : rawValues.Select(v => Math.Round(v, 1)).ToList();

        const double W = 580, H = 210;
        const double cL = 44, cR = 526;
        const double cT = 14, cB = 162;
        const double cW = cR - cL;
        const double cH = cB - cT;

        double ToY(double pci) => cT + (1.0 - pci / 100.0) * cH;
        double ToX(int i) => history.Count > 1
            ? cL + (double)i / (history.Count - 1) * cW
            : cL + cW / 2.0;

        var pts = vals.Select((v, i) => (x: ToX(i), y: ToY(v), v, p: history[i])).ToList();

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox=\"0 0 {W} {H}\" style=\"width:100%;height:210px;display:block;\" font-family=\"system-ui,sans-serif\">");

        sb.Append($"<rect x=\"{cL}\" y=\"{cT}\" width=\"{cW}\" height=\"{cH}\" fill=\"#f8fafc\" rx=\"3\" stroke=\"#e2e8f0\"/>");

        foreach (int g in new[] { 0, 20, 40, 60, 80, 100 })
        {
            double gy = ToY(g);
            sb.Append($"<line x1=\"{cL}\" y1=\"{gy:F0}\" x2=\"{cR}\" y2=\"{gy:F0}\" stroke=\"#e2e8f0\" stroke-width=\"1\"/>");
            sb.Append($"<text x=\"{cL - 4}\" y=\"{gy + 4:F0}\" text-anchor=\"end\" font-size=\"9\" fill=\"#94a3b8\">{g}%</text>");
        }

        double gy85 = ToY(85), gy70 = ToY(70);
        sb.Append($"<line x1=\"{cL}\" y1=\"{gy85:F0}\" x2=\"{cR}\" y2=\"{gy85:F0}\" stroke=\"#16a34a\" stroke-width=\"1.5\" stroke-dasharray=\"5,3\"/>");
        sb.Append($"<text x=\"{cR + 3}\" y=\"{gy85 + 4:F0}\" font-size=\"9\" fill=\"#16a34a\" font-weight=\"600\">85%</text>");
        sb.Append($"<line x1=\"{cL}\" y1=\"{gy70:F0}\" x2=\"{cR}\" y2=\"{gy70:F0}\" stroke=\"#f59e0b\" stroke-width=\"1.5\" stroke-dasharray=\"5,3\"/>");
        sb.Append($"<text x=\"{cR + 3}\" y=\"{gy70 + 4:F0}\" font-size=\"9\" fill=\"#f59e0b\" font-weight=\"600\">70%</text>");

        var areaPts = $"{cL},{cB:F0} " + string.Join(" ", pts.Select(p => $"{p.x:F0},{p.y:F0}")) + $" {cR},{cB:F0}";
        sb.Append($"<polygon points=\"{areaPts}\" fill=\"#2563eb\" opacity=\"0.07\"/>");

        var linePts = string.Join(" ", pts.Select(p => $"{p.x:F0},{p.y:F0}"));
        sb.Append($"<polyline points=\"{linePts}\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>");

        foreach (var pt in pts)
        {
            var col = pt.p.Status switch { "Conformant" => "#16a34a", "NeedsReview" => "#f59e0b", "NonConformant" => "#dc2626", _ => "#94a3b8" };
            double lblY = Math.Max(cT + 10, pt.y - 7);
            sb.Append($"<text x=\"{pt.x:F0}\" y=\"{lblY:F0}\" text-anchor=\"middle\" font-size=\"9\" fill=\"#374151\" font-weight=\"500\">{pt.v:N0}%</text>");
            sb.Append($"<circle cx=\"{pt.x:F0}\" cy=\"{pt.y:F0}\" r=\"5\" fill=\"{col}\" stroke=\"white\" stroke-width=\"2\"/>");
            sb.Append($"<text x=\"{pt.x:F0}\" y=\"{cB + 14}\" text-anchor=\"middle\" font-size=\"9\" fill=\"#64748b\">{pt.p.Date.ToLocalTime():dd.MM}</text>");
        }

        sb.Append("</svg>");
        return sb.ToString();
    }

