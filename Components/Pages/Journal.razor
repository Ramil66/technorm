@page "/journal"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IAuditLogService AuditSvc
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>История — ТехНорм</PageTitle>

@if (errorMessage is not null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" style="font-size:13px;">
        <i class="fa-solid fa-circle-exclamation"></i>@errorMessage
    </div>
}

<div class="page-header">
    <h1><i class="fa-solid fa-clock-rotate-left" style="color:var(--tn-blue);margin-right:10px;font-size:18px;"></i>История действий</h1>
    <span class="text-muted" style="font-size:13px;">@filteredLogs.Count из @allLogs.Count записей</span>
</div>

<!-- Фильтры -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2">
            <div class="col-md-4">
                <input class="form-control form-control-sm" placeholder="Поиск по действию..."
                       @bind="filterSearch" @bind:after="ApplyFilter" />
            </div>
            @if (isAdmin)
            {
                <div class="col-md-3">
                    <select class="form-select form-select-sm" @bind="filterUserId" @bind:after="ApplyFilter">
                        <option value="0">Все пользователи</option>
                        @foreach (var u in filterUsers)
                        {
                            <option value="@u.Id">@u.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-2">
                <input type="date" class="form-control form-control-sm" title="С даты"
                       @bind="filterDateFrom" @bind:after="ApplyFilter" />
            </div>
            <div class="col-md-2">
                <input type="date" class="form-control form-control-sm" title="По дату"
                       @bind="filterDateTo" @bind:after="ApplyFilter" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-secondary" title="Сбросить фильтры"
                        @onclick="ClearFilters">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Таблица -->
<div class="card">
    <div class="card-body p-0">
        @if (!filteredLogs.Any())
        {
            <div class="empty-state">
                <i class="fa-solid fa-clock-rotate-left d-block"></i>
                <div>Действий не найдено</div>
            </div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th style="width:36px;"></th>
                            <th>Пользователь</th>
                            <th>Действие</th>
                            <th style="white-space:nowrap;">Дата и время</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in filteredLogs)
                        {
                            <tr>
                                <td>
                                    <div class="event-icon" style="@ActionIconStyle(log.Action);width:28px;height:28px;font-size:12px;">
                                        <i class="fa-solid @ActionIcon(log.Action)"></i>
                                    </div>
                                </td>
                                <td style="font-weight:500;">@(log.User?.FullName ?? "—")</td>
                                <td>
                                    <div>@log.Action</div>
                                    @{ var detail = GetLogDetail(log); }
                                    @if (detail is not null)
                                    {
                                        <div style="font-size:11px;color:var(--tn-text-muted);margin-top:2px;">@detail</div>
                                    }
                                </td>
                                <td style="white-space:nowrap;color:var(--tn-text-muted);font-size:13px;">
                                    @log.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool                        isAdmin      = false;
    private int                         currentUserId;
    private string?                     errorMessage;
    private List<AuditLog>              allLogs      = [];
    private List<AuditLog>              filteredLogs = [];
    private string                      filterSearch   = "";
    private int                         filterUserId   = 0;
    private DateTime?                   filterDateFrom;
    private DateTime?                   filterDateTo;
    private List<(int Id, string Name)> filterUsers  = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthStateTask;
            isAdmin       = state.User.IsInRole("admin");
            currentUserId = int.Parse(state.User.FindFirst("UserId")?.Value ?? "0");

            var raw = await AuditSvc.GetRecentAsync(500);
            allLogs = isAdmin ? raw : raw.Where(l => l.UserId == currentUserId).ToList();

            if (isAdmin)
            {
                filterUsers = allLogs
                    .Where(l => l.User is not null && l.UserId.HasValue)
                    .Select(l => (l.UserId!.Value, l.User!.FullName))
                    .DistinctBy(u => u.Item1)
                    .OrderBy(u => u.Item2)
                    .ToList();
            }
            ApplyFilter();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки истории: {ex.Message}";
        }
    }

    private void ApplyFilter()
    {
        filteredLogs = allLogs
            .Where(l => string.IsNullOrEmpty(filterSearch) ||
                        l.Action.Contains(filterSearch, StringComparison.OrdinalIgnoreCase))
            .Where(l => filterUserId == 0 || l.UserId == filterUserId)
            .Where(l => filterDateFrom is null ||
                        l.CreatedAt.ToLocalTime().Date >= filterDateFrom.Value.Date)
            .Where(l => filterDateTo is null ||
                        l.CreatedAt.ToLocalTime().Date <= filterDateTo.Value.Date)
            .ToList();
    }

    private void ClearFilters()
    {
        filterSearch   = "";
        filterUserId   = 0;
        filterDateFrom = null;
        filterDateTo   = null;
        ApplyFilter();
    }

    private static string? GetLogDetail(AuditLog log)
    {
        if (log.OldValue is not null && log.NewValue is not null)
        {
            var oldR = log.OldValue.RootElement;
            var newR = log.NewValue.RootElement;
            if (oldR.TryGetProperty("oldName", out var oldN) && newR.TryGetProperty("newName", out var newN))
                return $"«{oldN.GetString()}» → «{newN.GetString()}»";
        }

        var doc = log.NewValue ?? log.OldValue;
        if (doc is null) return null;
        var root = doc.RootElement;
        var parts = new List<string>();

        if (root.TryGetProperty("Activity", out var act) && act.ValueKind == JsonValueKind.String && !string.IsNullOrEmpty(act.GetString()))
        {
            parts.Add($"«{act.GetString()}»");
            if (root.TryGetProperty("CaseId", out var caseId) && caseId.ValueKind == JsonValueKind.String)
                parts.Add($"дело: {caseId.GetString()}");
            return string.Join(", ", parts);
        }

        foreach (var field in new[] { "Name", "FileName", "OriginalName", "newName" })
        {
            if (root.TryGetProperty(field, out var v) && v.ValueKind == JsonValueKind.String && !string.IsNullOrEmpty(v.GetString()))
            {
                parts.Add($"«{v.GetString()}»");
                break;
            }
        }

        if (root.TryGetProperty("SequenceNum", out var seq) && seq.ValueKind == JsonValueKind.Number)
            parts.Add($"шаг #{seq.GetInt32()}");

        if (root.TryGetProperty("Version", out var ver) && ver.ValueKind == JsonValueKind.Number)
            parts.Add($"v{ver.GetInt32()}");

        if (root.TryGetProperty("EventCount", out var ec) && ec.ValueKind == JsonValueKind.Number)
            parts.Add($"{ec.GetInt32()} событий");

        return parts.Count > 0 ? string.Join(" ", parts) : null;
    }

    private static string ActionIcon(string action) => action.ToLower() switch
    {
        var a when a.Contains("создан") || a.Contains("create") || a.Contains("добавл") => "fa-plus",
        var a when a.Contains("удал")   || a.Contains("delete")                         => "fa-trash-can",
        var a when a.Contains("редакт") || a.Contains("update") || a.Contains("изменен") => "fa-pen",
        var a when a.Contains("загруз") || a.Contains("upload")                          => "fa-file-arrow-up",
        var a when a.Contains("вход")   || a.Contains("login")                           => "fa-right-to-bracket",
        var a when a.Contains("публик") || a.Contains("publish")                         => "fa-check-circle",
        _ => "fa-circle-dot",
    };

    private static string ActionIconStyle(string action) => action.ToLower() switch
    {
        var a when a.Contains("удал")   || a.Contains("delete")  => "background:#fef2f2;color:#dc2626;",
        var a when a.Contains("создан") || a.Contains("create") || a.Contains("добавл") => "background:#f0fdf4;color:#16a34a;",
        var a when a.Contains("публик") || a.Contains("publish") => "background:#fef9c3;color:#ca8a04;",
        _ => "background:#eff6ff;color:#2563eb;",
    };
}
